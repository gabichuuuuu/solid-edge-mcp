# A40: match face of sheet metal (se_sheetmetal match_face): a flange moved onto a parallel plane with its outer face, short of
# the plane and beyond it, outwards, with its inner face, and with a planar face of the sheet as the plane; refusals (no face, no
# plane, a face that is not planar, a plane that is not parallel, the edge face of the flange, a part document).
# Each sheet: tab 100 x 60 x 1 mm on the base plane with a 20 mm flange on its edge y = 0 (bend radius 1): 7935.619449 mm3,
# the outer face of the flange at y = 0 and its inner face at y = 1.
@d1 = se_documents {"action":"new","kind":"sheet_metal"}
@k1 = se_sketch {"action":"create","plane":"1"}
se_sketch {"action":"rectangle","sketch":"{{k1.sketch}}","points":[0,0,100,60]}
se_sketch {"action":"close","sketch":"{{k1.sketch}}"}
se_sheetmetal {"action":"tab","sketch":"{{k1.sketch}}"}
@top1 = se_geometry {"action":"faces","direction":[0,0,1]}
@te1 = se_geometry {"action":"edges","source":"{{top1.items[0].handle}}","direction":[1,0,0]}
@fl1 = se_sheetmetal {"action":"flange","edges":["{{te1.items[0].handle}}"],"length":20}
?= fl1.volume 7935.619449 0.01
@y1 = se_ref_plane {"action":"offset","plane":"3","distance":-10}
?= y1.rootPoint[1] 10
@z1 = se_ref_plane {"action":"offset","plane":"1","distance":30}
@out1 = se_geometry {"action":"faces","direction":[0,-1,0]}
@cyl1 = se_geometry {"action":"faces","type":"cylinder"}
@up1 = se_geometry {"action":"faces","direction":[0,0,1]}
@tree0 = se_feature_tree {}
# Refusals before anything changes.
! [invalid_argument] se_sheetmetal {"action":"match_face","plane":"{{y1.handle}}"}
! [invalid_argument] se_sheetmetal {"action":"match_face","faces":["{{out1.items[0].handle}}"]}
! [invalid_argument] se_sheetmetal {"action":"match_face","faces":["{{cyl1.items[0].handle}}"],"plane":"{{y1.handle}}"}
! [invalid_argument] se_sheetmetal {"action":"match_face","faces":["{{out1.items[0].handle}}"],"plane":"{{z1.handle}}"}
# The edge face of the flange (z = 21) to a plane parallel to it: Solid Edge leaves the feature failed and it is deleted.
! [feature_failed] se_sheetmetal {"action":"match_face","faces":["{{up1.items[?area=100].handle}}"],"plane":"{{z1.handle}}"}
@tree1 = se_feature_tree {}
?= tree1.count {{tree0.count}}
?= tree1.volume 7935.619449 0.01
# Outer face onto the plane at y = 10: the tab is 10 mm shorter (the failed attempt changed the model: faces are read again).
@o1 = se_geometry {"action":"faces","direction":[0,-1,0]}
@m1 = se_sheetmetal {"action":"match_face","faces":["{{o1.items[0].handle}}"],"plane":"{{y1.handle}}"}
?~ m1.feature.type MatchFlangeFace
?= m1.feature.status ok
?= m1.volume 6935.619449 0.01
?= m1.volumeChange -1000 0.01
@g1 = se_geometry {"action":"faces","direction":[0,-1,0]}
?= g1.items[0].boundingBox.min[1] 10
?= g1.items[0].boundingBox.max[1] 10
@tree2 = se_feature_tree {}
?= tree2.volume 6935.619449 0.01
se_documents {"action":"close","saveChanges":false}
# 5 mm short of the plane, on the side the face comes from: y = 5.
@d2 = se_documents {"action":"new","kind":"sheet_metal"}
@k2 = se_sketch {"action":"create","plane":"1"}
se_sketch {"action":"rectangle","sketch":"{{k2.sketch}}","points":[0,0,100,60]}
se_sketch {"action":"close","sketch":"{{k2.sketch}}"}
se_sheetmetal {"action":"tab","sketch":"{{k2.sketch}}"}
@top2 = se_geometry {"action":"faces","direction":[0,0,1]}
@te2 = se_geometry {"action":"edges","source":"{{top2.items[0].handle}}","direction":[1,0,0]}
@fl2 = se_sheetmetal {"action":"flange","edges":["{{te2.items[0].handle}}"],"length":20}
?= fl2.volume 7935.619449 0.01
@y2 = se_ref_plane {"action":"offset","plane":"3","distance":-10}
@out2 = se_geometry {"action":"faces","direction":[0,-1,0]}
@m2 = se_sheetmetal {"action":"match_face","faces":["{{out2.items[0].handle}}"],"plane":"{{y2.handle}}","distance":5}
?= m2.volume 7435.619449 0.01
@g2 = se_geometry {"action":"faces","direction":[0,-1,0]}
?= g2.items[0].boundingBox.min[1] 5
se_documents {"action":"close","saveChanges":false}
# 5 mm beyond the plane: y = 15.
@d3 = se_documents {"action":"new","kind":"sheet_metal"}
@k3 = se_sketch {"action":"create","plane":"1"}
se_sketch {"action":"rectangle","sketch":"{{k3.sketch}}","points":[0,0,100,60]}
se_sketch {"action":"close","sketch":"{{k3.sketch}}"}
se_sheetmetal {"action":"tab","sketch":"{{k3.sketch}}"}
@top3 = se_geometry {"action":"faces","direction":[0,0,1]}
@te3 = se_geometry {"action":"edges","source":"{{top3.items[0].handle}}","direction":[1,0,0]}
@fl3 = se_sheetmetal {"action":"flange","edges":["{{te3.items[0].handle}}"],"length":20}
?= fl3.volume 7935.619449 0.01
@y3 = se_ref_plane {"action":"offset","plane":"3","distance":-10}
@out3 = se_geometry {"action":"faces","direction":[0,-1,0]}
@m3 = se_sheetmetal {"action":"match_face","faces":["{{out3.items[0].handle}}"],"plane":"{{y3.handle}}","distance":-5}
?= m3.volume 6435.619449 0.01
@g3 = se_geometry {"action":"faces","direction":[0,-1,0]}
?= g3.items[0].boundingBox.min[1] 15
se_documents {"action":"close","saveChanges":false}
# Outwards, onto a plane at y = -10: the tab is 10 mm longer.
@d4 = se_documents {"action":"new","kind":"sheet_metal"}
@k4 = se_sketch {"action":"create","plane":"1"}
se_sketch {"action":"rectangle","sketch":"{{k4.sketch}}","points":[0,0,100,60]}
se_sketch {"action":"close","sketch":"{{k4.sketch}}"}
se_sheetmetal {"action":"tab","sketch":"{{k4.sketch}}"}
@top4 = se_geometry {"action":"faces","direction":[0,0,1]}
@te4 = se_geometry {"action":"edges","source":"{{top4.items[0].handle}}","direction":[1,0,0]}
@fl4 = se_sheetmetal {"action":"flange","edges":["{{te4.items[0].handle}}"],"length":20}
?= fl4.volume 7935.619449 0.01
@y4 = se_ref_plane {"action":"offset","plane":"3","distance":10}
?= y4.rootPoint[1] -10
@out4 = se_geometry {"action":"faces","direction":[0,-1,0]}
@m4 = se_sheetmetal {"action":"match_face","faces":["{{out4.items[0].handle}}"],"plane":"{{y4.handle}}"}
?= m4.volume 8935.619449 0.01
?= m4.volumeChange 1000 0.01
@g4 = se_geometry {"action":"faces","direction":[0,-1,0]}
?= g4.items[0].boundingBox.min[1] -10
se_documents {"action":"close","saveChanges":false}
# The inner face onto the plane at y = 10: the outer face ends at y = 9.
@d5 = se_documents {"action":"new","kind":"sheet_metal"}
@k5 = se_sketch {"action":"create","plane":"1"}
se_sketch {"action":"rectangle","sketch":"{{k5.sketch}}","points":[0,0,100,60]}
se_sketch {"action":"close","sketch":"{{k5.sketch}}"}
se_sheetmetal {"action":"tab","sketch":"{{k5.sketch}}"}
@top5 = se_geometry {"action":"faces","direction":[0,0,1]}
@te5 = se_geometry {"action":"edges","source":"{{top5.items[0].handle}}","direction":[1,0,0]}
@fl5 = se_sheetmetal {"action":"flange","edges":["{{te5.items[0].handle}}"],"length":20}
?= fl5.volume 7935.619449 0.01
@y5 = se_ref_plane {"action":"offset","plane":"3","distance":-10}
@in5 = se_geometry {"action":"faces","direction":[0,1,0]}
@m5 = se_sheetmetal {"action":"match_face","faces":["{{in5.items[?area=1900].handle}}"],"plane":"{{y5.handle}}"}
?= m5.volume 7035.619449 0.01
@g5 = se_geometry {"action":"faces","direction":[0,-1,0]}
?= g5.items[0].boundingBox.min[1] 9
se_documents {"action":"close","saveChanges":false}
# A planar face as the plane: 20 mm short of the end face of the tab (y = 60), so the flange ends at y = 40.
@d6 = se_documents {"action":"new","kind":"sheet_metal"}
@k6 = se_sketch {"action":"create","plane":"1"}
se_sketch {"action":"rectangle","sketch":"{{k6.sketch}}","points":[0,0,100,60]}
se_sketch {"action":"close","sketch":"{{k6.sketch}}"}
se_sheetmetal {"action":"tab","sketch":"{{k6.sketch}}"}
@top6 = se_geometry {"action":"faces","direction":[0,0,1]}
@te6 = se_geometry {"action":"edges","source":"{{top6.items[0].handle}}","direction":[1,0,0]}
@fl6 = se_sheetmetal {"action":"flange","edges":["{{te6.items[0].handle}}"],"length":20}
?= fl6.volume 7935.619449 0.01
@end6 = se_geometry {"action":"faces","direction":[0,1,0]}
@out6 = se_geometry {"action":"faces","direction":[0,-1,0]}
@m6 = se_sheetmetal {"action":"match_face","faces":["{{out6.items[0].handle}}"],"plane":"{{end6.items[?area=100].handle}}","distance":20}
?= m6.volume 3935.619449 0.01
@g6 = se_geometry {"action":"faces","direction":[0,-1,0]}
?= g6.items[0].boundingBox.min[1] 40
se_documents {"action":"close","saveChanges":false}
# A part is not sheet metal.
@p7 = se_documents {"action":"new","kind":"part"}
@b7 = se_primitive {"shape":"box","center":[50,30,0],"size":[100,60],"depth":20}
@f7 = se_geometry {"action":"faces","type":"plane","direction":[0,-1,0]}
! [wrong_document_type] se_sheetmetal {"action":"match_face","faces":["{{f7.items[0].handle}}"],"plane":"3"}
se_documents {"action":"close","saveChanges":false}
