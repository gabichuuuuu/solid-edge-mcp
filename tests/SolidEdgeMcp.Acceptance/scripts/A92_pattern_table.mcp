# A92: pattern by table. A Ø10 hole at (20, 20) through a 100 x 60 x 20 block copied 30 along x and (30, 25): holes at
#   (50, 20) and (50, 45), pi 25 20 = 1570.796 mm3 less each.
@p = se_documents {"action":"new","kind":"part"}
@k = se_sketch {"action":"create","plane":"1"}
se_sketch {"action":"rectangle","sketch":"{{k.sketch}}","points":[0,0,100,60]}
se_sketch {"action":"close","sketch":"{{k.sketch}}"}
se_extrude {"sketch":"{{k.sketch}}","distance":20}
@kh = se_sketch {"action":"create","plane":"1"}
se_sketch {"action":"circle","sketch":"{{kh.sketch}}","center":[20,20],"radius":5}
se_sketch {"action":"close","sketch":"{{kh.sketch}}"}
@h = se_extrude {"sketch":"{{kh.sketch}}","operation":"cut","extent":"through_all"}
@t = se_pattern {"type":"table","features":["{{h.feature.handle}}"],"offsets":[30,0,0,30,25,0]}
?= t.volumeChange -3141.593 0.01
?= t.feature.type Pattern
@cy = se_geometry {"action":"faces","type":"cylinder"}
?= cy.returned 3
! [invalid_argument] se_pattern {"type":"table","features":["{{h.feature.handle}}"],"offsets":[0,0,0]}
! [invalid_argument] se_pattern {"type":"table","features":["{{h.feature.handle}}"],"offsets":[30,0]}
! [invalid_argument] se_pattern {"type":"table","features":["{{h.feature.handle}}"]}
se_documents {"action":"close","document":"{{p.handle}}","saveChanges":false}
