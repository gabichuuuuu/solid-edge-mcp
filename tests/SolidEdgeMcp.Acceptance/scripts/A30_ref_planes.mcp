# A30: reference planes and coordinate systems (se_ref_plane) in a part and an assembly. Part: planes are global (in the
# feature tree), renamed, hidden and deleted, and a plane that a plane, a sketch or a feature is built on is kept. Assembly:
# planes offset from base planes and from a face of an occurrence, turned about a hinge, normal to an edge of an occurrence,
# a coordinate system, show and hide of every plane, and the same delete checks with an assembly sketch and a relation.
# Block 40 x 20 x 10 at x 10..50, y -10..10, z 0..10; in the assembly it is moved 100 mm along x (x 110..150).
# Every document is new and is closed without saving, except the block a30_block.par used by the assembly.
@p = se_documents {"action":"new","kind":"part"}
@k = se_sketch {"action":"create","plane":"xy"}
se_sketch {"action":"rectangle","sketch":"{{k.sketch}}","points":[10,-10,50,10]}
se_sketch {"action":"close","sketch":"{{k.sketch}}"}
se_extrude {"sketch":"{{k.sketch}}","distance":10}
se_documents {"action":"save_as","path":"{{work}}\\a30_block.par","overwrite":true}
@t0 = se_feature_tree {}
# Global planes: each one is a new entry of the feature tree, shown, with a name
@q = se_ref_plane {"action":"offset","plane":"xy","distance":20}
?= q.rootPoint[2] 20
?= q.visible true
@q2 = se_ref_plane {"action":"angle","plane":"{{q.handle}}","pivot":"xz","angle":30}
?= q2.normal[2] 0.866025404 1e-6
?= q2.rootPoint[2] 20
@t1 = se_feature_tree {}
# Base planes, sketch and extrusion (5), then the two planes
?= t0.count 5
?= t1.count 7
@qr = se_ref_plane {"action":"rename","plane":"{{q.handle}}","name":"Datum_Q"}
?= qr.name Datum_Q
@qh = se_ref_plane {"action":"hide","plane":"{{q.handle}}"}
?= qh.visible false
?= qh.changed[0] Datum_Q
@lq = se_ref_plane {"action":"list"}
?= lq.planes[3].name Datum_Q
?= lq.planes[3].visible false
# Delete keeps what is built on a plane: q2 on q, a sketch and its extrusion on q2; the base planes are refused
@ks = se_sketch {"action":"create","plane":"{{q2.handle}}"}
se_sketch {"action":"circle","sketch":"{{ks.sketch}}","center":[30,0],"radius":5}
se_sketch {"action":"close","sketch":"{{ks.sketch}}"}
se_extrude {"sketch":"{{ks.sketch}}","distance":5}
! [in_use] se_ref_plane {"action":"delete","plane":"{{q.handle}}"}
! [in_use] se_ref_plane {"action":"delete","plane":"{{q2.handle}}"}
! [invalid_argument] se_ref_plane {"action":"delete","plane":"xy"}
@t2 = se_feature_tree {}
@q3 = se_ref_plane {"action":"offset","plane":"yz","distance":-15}
@d3 = se_ref_plane {"action":"delete","plane":"{{q3.handle}}"}
?= d3.deleted {{q3.name}}
@t3 = se_feature_tree {}
?= t3.count {{t2.count}}
! [handle_expired] se_ref_plane {"action":"show","plane":"{{q3.handle}}"}
# Coordinate systems: rename and delete; the base one is refused
@c = se_ref_plane {"action":"coordinate_system","origin":[5,0,0],"angles":[0,0,90]}
?= c.xAxis[1] 1 1e-6
@cr = se_ref_plane {"action":"rename","plane":"{{c.handle}}","name":"CS_side"}
?= cr.name CS_side
@cs = se_ref_plane {"action":"coordinate_systems"}
?= cs.count 2
! [invalid_argument] se_ref_plane {"action":"delete","plane":"{{cs.coordinateSystems[0].handle}}"}
@dc = se_ref_plane {"action":"delete","plane":"{{c.handle}}"}
?= dc.deleted CS_side
# Assembly: the block at x 110..150
@as = se_documents {"action":"new","kind":"assembly"}
@o = se_assembly {"action":"insert","path":"{{work}}\\a30_block.par"}
se_assembly {"action":"move","occurrence":"{{o.handle}}","delta":[100,0,0]}
@l0 = se_ref_plane {"action":"list"}
?= l0.count 3
# Offsets from the front plane (normal -y): 25 along the normal is y = -25; -25 and flip go the other way
@a = se_ref_plane {"action":"offset","plane":"xz","distance":25}
?= a.rootPoint[1] -25
?= a.normal[1] -1
@a2 = se_ref_plane {"action":"offset","plane":"xz","distance":-25}
?= a2.rootPoint[1] 25
@a3 = se_ref_plane {"action":"offset","plane":"xz","distance":25,"flip":true}
?= a3.rootPoint[1] 25
# From the face y = -10 of the occurrence (outward normal -y): 5 mm out of the material and 5 mm into it
@g = se_geometry {"action":"faces","source":"{{o.handle}}","type":"plane","direction":[0,-1,0]}
@f = se_ref_plane {"action":"offset","plane":"{{g.items[0].handle}}","distance":5}
?= f.rootPoint[1] -15
?= f.normal[1] -1
@f2 = se_ref_plane {"action":"offset","plane":"{{g.items[0].handle}}","distance":-5}
?= f2.rootPoint[1] -5
# Turned about the line where the parent meets the top plane: 30 and -30 degrees from a (y = -25), 120 from the face
@b = se_ref_plane {"action":"angle","plane":"{{a.handle}}","pivot":"xy","angle":30}
?= b.normal[1] -0.866025404 1e-6
?= b.normal[2] 0.5 1e-6
?= b.rootPoint[1] -25
@b2 = se_ref_plane {"action":"angle","plane":"{{a.handle}}","pivot":"xy","angle":-30}
?= b2.normal[2] -0.5 1e-6
@b3 = se_ref_plane {"action":"angle","plane":"{{g.items[0].handle}}","pivot":"xy","angle":120}
?= b3.normal[1] 0.5 1e-6
?= b3.normal[2] 0.866025404 1e-6
! [invalid_argument] se_ref_plane {"action":"angle","plane":"{{a.handle}}","pivot":"xz","angle":30}
# Normal to the edge (110,-10,0)-(150,-10,0): at its start, 10 mm from its end, a quarter of its length from the start
@e = se_geometry {"action":"edges","source":"{{o.handle}}","type":"line","direction":[1,0,0],"limit":1}
?= e.items[0].start[0] 110
@n1 = se_ref_plane {"action":"normal_to_edge","edge":"{{e.items[0].handle}}","at":"start"}
?= n1.rootPoint[0] 110
@n2 = se_ref_plane {"action":"normal_to_edge","edge":"{{e.items[0].handle}}","at":"end","distance":10}
?= n2.rootPoint[0] 140
@n3 = se_ref_plane {"action":"normal_to_edge","edge":"{{e.items[0].handle}}","at":"start","ratio":0.25}
?= n3.rootPoint[0] 120
?= n3.normal[0] -1
# Only in parts
! [not_supported] se_ref_plane {"action":"three_points","points":[110,-10,0,150,-10,0,110,10,0]}
! [not_supported] se_ref_plane {"action":"mid","plane":"xz","plane2":"{{a.handle}}"}
# Coordinate system by origin and angles, listed after the base one
@c2 = se_ref_plane {"action":"coordinate_system","origin":[10,20,30],"angles":[0,0,30]}
?= c2.origin[1] 20
?= c2.xAxis[0] 0.866025404 1e-6
?= c2.xAxis[1] 0.5 1e-6
@cl = se_ref_plane {"action":"coordinate_systems"}
?= cl.count 2
?= cl.coordinateSystems[1].origin[2] 30
# Hide every plane, then show the top one
@ha = se_ref_plane {"action":"hide","plane":"all"}
@la = se_ref_plane {"action":"list"}
?= la.count 14
?= la.planes[0].visible false
?= la.planes[13].visible false
se_ref_plane {"action":"show","plane":"xy"}
@lb = se_ref_plane {"action":"list"}
?= lb.planes[0].visible true
?= lb.planes[1].visible false
@r = se_ref_plane {"action":"rename","plane":"{{a.handle}}","name":"Datum_A"}
?= r.name Datum_A
# Delete: refused for a base plane, a plane others are built on (b on a), a plane with an assembly sketch (b3) and a plane
# with a relation (a2, mated to the face of the block); a free plane (a3) and the new coordinate system go
! [invalid_argument] se_ref_plane {"action":"delete","plane":"1"}
! [in_use] se_ref_plane {"action":"delete","plane":"{{a.handle}}"}
@kb = se_sketch {"action":"create","plane":"{{b3.handle}}"}
se_sketch {"action":"circle","sketch":"{{kb.sketch}}","center":[0,0],"radius":5}
se_sketch {"action":"close","sketch":"{{kb.sketch}}"}
! [in_use] se_ref_plane {"action":"delete","plane":"{{b3.handle}}"}
se_assembly {"action":"unground","occurrence":"{{o.handle}}"}
@g2 = se_geometry {"action":"faces","source":"{{o.handle}}","type":"plane","direction":[0,-1,0]}
se_relations {"action":"add","type":"planar","occurrence1":"{{o.handle}}","element1":"{{g2.items[0].handle}}","element2":"{{a2.handle}}"}
! [in_use] se_ref_plane {"action":"delete","plane":"{{a2.handle}}"}
@d = se_ref_plane {"action":"delete","plane":"{{a3.handle}}"}
?~ d.deleted Plane
@l1 = se_ref_plane {"action":"list"}
?= l1.count 13
! [invalid_argument] se_ref_plane {"action":"delete","plane":"{{cl.coordinateSystems[0].handle}}"}
@dc2 = se_ref_plane {"action":"delete","plane":"{{c2.handle}}"}
@cl2 = se_ref_plane {"action":"coordinate_systems"}
?= cl2.count 1
se_documents {"action":"close","document":"{{as.handle}}","saveChanges":false}
se_documents {"action":"close","document":"{{p.handle}}","saveChanges":false}
