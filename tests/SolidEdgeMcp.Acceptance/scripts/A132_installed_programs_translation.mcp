# A132: the programs installed with Solid Edge beside Design Manager. The installation read by se_server_info (InstallData);
# the thumbnails saved in closed files (SeThumbnail, 128 x 128); the formats of Solid Edge Translation Services that se_export
# had not offered (CATIA V5 and V4 of a part, OBJ with its material file, PLM XML with a Parasolid file per body, U3D and
# XGL, an assembly refused for CATIA), the CATIA files imported again with the volume of the plate (100 x 60 x 10 =
# 60000 mm3); and batch exports of saved files and folders as Translation Services makes them: a folder with its subfolders
# to STEP (drawings left out, the subfolder kept), two files that would write the same PDF (the second refused), a file
# open in Solid Edge exported from its document, which stays open, an assembly in a CATIA batch refused without opening
# it, and a STEP file of the batch read back.
se_session {"action":"connect"}
@docs0 = se_documents {"action":"list"}
?= docs0.count 0 0
@info = se_server_info {}
?~ info.solidEdge.version 226.
?~ info.solidEdge.programFolder Program
?~ info.solidEdge.parasolid .
# A plate, a tray in a subfolder, an assembly of both and a drawing of the plate
@p = se_documents {"action":"new","kind":"part"}
@ps = se_sketch {"action":"create","plane":"1"}
se_sketch {"action":"rectangle","sketch":"{{ps.sketch}}","points":[0,0,100,60]}
se_sketch {"action":"close","sketch":"{{ps.sketch}}"}
se_extrude {"sketch":"{{ps.sketch}}","distance":10}
se_documents {"action":"save_as","path":"{{work}}\\runs\\a132_{{run}}\\src\\plate.par"}
se_documents {"action":"close","document":"{{p.handle}}","saveChanges":false}
@s = se_documents {"action":"new","kind":"sheet_metal"}
@ss = se_sketch {"action":"create","plane":"1"}
se_sketch {"action":"rectangle","sketch":"{{ss.sketch}}","points":[0,0,80,40]}
se_sketch {"action":"close","sketch":"{{ss.sketch}}"}
se_sheetmetal {"action":"tab","sketch":"{{ss.sketch}}"}
se_documents {"action":"save_as","path":"{{work}}\\runs\\a132_{{run}}\\src\\sub\\tray.psm"}
se_documents {"action":"close","document":"{{s.handle}}","saveChanges":false}
@a = se_documents {"action":"new","kind":"assembly"}
se_assembly {"action":"insert","path":"{{work}}\\runs\\a132_{{run}}\\src\\plate.par","document":"{{a.handle}}"}
se_assembly {"action":"insert","path":"{{work}}\\runs\\a132_{{run}}\\src\\sub\\tray.psm","origin":[0,0,30],"document":"{{a.handle}}"}
se_documents {"action":"save_as","path":"{{work}}\\runs\\a132_{{run}}\\src\\top.asm"}
se_documents {"action":"close","document":"{{a.handle}}","saveChanges":false}
@dr = se_documents {"action":"new","kind":"draft"}
se_drawing {"action":"base_view","path":"{{work}}\\runs\\a132_{{run}}\\src\\plate.par","orientation":"top","position":[150,150]}
se_documents {"action":"save_as","path":"{{work}}\\runs\\a132_{{run}}\\src\\plate.dft"}
se_documents {"action":"close","document":"{{dr.handle}}","saveChanges":false}
# Thumbnails of the closed files
@t1 = se_documents {"action":"thumbnail","path":"{{work}}\\runs\\a132_{{run}}\\src\\plate.par"}
?= t1.width 128
?= t1.height 128
@t2 = se_documents {"action":"thumbnail","path":"{{work}}\\runs\\a132_{{run}}\\src\\top.asm"}
?= t2.width 128
@t3 = se_documents {"action":"thumbnail","path":"{{work}}\\runs\\a132_{{run}}\\src\\plate.dft"}
?= t3.height 128
! [not_found] se_documents {"action":"thumbnail","path":"{{work}}\\runs\\a132_{{run}}\\src\\nothing.par"}
# The formats of Translation Services
@o = se_documents {"action":"open","path":"{{work}}\\runs\\a132_{{run}}\\src\\plate.par"}
@e1 = se_export {"path":"{{work}}\\runs\\a132_{{run}}\\out\\plate.catpart"}
?~ e1.format V5
@e2 = se_export {"path":"{{work}}\\runs\\a132_{{run}}\\out\\plate.model"}
?~ e2.format V4
@e3 = se_export {"path":"{{work}}\\runs\\a132_{{run}}\\out\\plate.obj"}
?~ e3.alsoWritten plate.mtl
@e4 = se_export {"path":"{{work}}\\runs\\a132_{{run}}\\out\\plate.plmxml"}
?~ e4.alsoWritten .x_b
@e5 = se_export {"path":"{{work}}\\runs\\a132_{{run}}\\out\\plate.u3d"}
?= e5.format U3D
@e6 = se_export {"path":"{{work}}\\runs\\a132_{{run}}\\out\\plate.xgl"}
?= e6.format XGL
! [invalid_argument] se_export {"path":"{{work}}\\runs\\a132_{{run}}\\out\\plate.wrl"}
se_documents {"action":"close","document":"{{o.handle}}","saveChanges":false}
@oa = se_documents {"action":"open","path":"{{work}}\\runs\\a132_{{run}}\\src\\top.asm"}
! [invalid_argument] se_export {"path":"{{work}}\\runs\\a132_{{run}}\\out\\top.catpart"}
@e7 = se_export {"path":"{{work}}\\runs\\a132_{{run}}\\out\\top.obj"}
?~ e7.alsoWritten top.mtl
se_documents {"action":"close","document":"{{oa.handle}}","saveChanges":false}
! [invalid_argument] se_documents {"action":"thumbnail","path":"{{work}}\\runs\\a132_{{run}}\\out\\plate.obj"}
# The CATIA files read back
@i1 = se_documents {"action":"import","path":"{{work}}\\runs\\a132_{{run}}\\out\\plate.catpart"}
?= i1.volume 60000 0.01
se_documents {"action":"close","document":"{{i1.document.handle}}","saveChanges":false}
@i2 = se_documents {"action":"import","path":"{{work}}\\runs\\a132_{{run}}\\out\\plate.model"}
?= i2.volume 60000 0.01
se_documents {"action":"close","document":"{{i2.document.handle}}","saveChanges":false}
# Batches, as Translation Services
@b1 = se_export {"files":["{{work}}\\runs\\a132_{{run}}\\src"],"format":"step","path":"{{work}}\\runs\\a132_{{run}}\\step","subfolders":true}
?= b1.count 3
?= b1.exported 3
?~ b1.files sub\\tray.step
@b2 = se_export {"files":["{{work}}\\runs\\a132_{{run}}\\src\\plate.dft","{{work}}\\runs\\a132_{{run}}\\src\\plate.par"],"format":"pdf","path":"{{work}}\\runs\\a132_{{run}}\\pdf"}
?= b2.count 2
?= b2.exported 1
?~ b2.files same_target
@b4 = se_export {"files":["{{work}}\\runs\\a132_{{run}}\\src\\top.asm","{{work}}\\runs\\a132_{{run}}\\src\\plate.par"],"format":"catpart","path":"{{work}}\\runs\\a132_{{run}}\\cat"}
?= b4.count 2
?= b4.exported 1
?~ b4.files invalid_argument
@docs3 = se_documents {"action":"list"}
?= docs3.count 0 0
@o2 = se_documents {"action":"open","path":"{{work}}\\runs\\a132_{{run}}\\src\\plate.par"}
@b3 = se_export {"files":["{{work}}\\runs\\a132_{{run}}\\src\\plate.par"],"format":".x_t","path":"{{work}}\\runs\\a132_{{run}}\\xt"}
?= b3.exported 1
@docs2 = se_documents {"action":"list"}
?= docs2.count 1
se_documents {"action":"close","document":"{{o2.handle}}","saveChanges":false}
! [not_found] se_export {"files":["{{work}}\\runs\\a132_{{run}}\\pdf"],"format":"step","path":"{{work}}\\runs\\a132_{{run}}\\none"}
! [invalid_argument] se_export {"files":["{{work}}\\runs\\a132_{{run}}\\src"],"format":"wrl","path":"{{work}}\\runs\\a132_{{run}}\\none"}
@i3 = se_documents {"action":"import","path":"{{work}}\\runs\\a132_{{run}}\\step\\plate.step"}
?= i3.volume 60000 0.01
se_documents {"action":"close","document":"{{i3.document.handle}}","saveChanges":false}
@docs1 = se_documents {"action":"list"}
?= docs1.count 0 0
