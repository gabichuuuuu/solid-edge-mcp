# A91: a regular polygon in a sketch, and the 3D Draw commands arc through three points, tangent arc, rectangle, mirror,
#   split, trim, equation driven curve and include (a model edge copied into a 3D sketch).
# 1) A hexagon with 20 mm to each vertex has sides of 20; extruded 10: (3 sqrt(3) / 2) 20^2 10 = 10392.305
@p = se_documents {"action":"new","kind":"part"}
@k = se_sketch {"action":"create","plane":"1"}
@pg = se_sketch {"action":"polygon","sketch":"{{k.sketch}}","center":[0,0],"radius":20,"sides":6}
?= pg.side 20
! [invalid_argument] se_sketch {"action":"polygon","sketch":"{{k.sketch}}","center":[0,0],"radius":20,"sides":2}
! [invalid_argument] se_sketch {"action":"polygon","sketch":"{{k.sketch}}","center":[0,0],"radius":20}
se_sketch {"action":"close","sketch":"{{k.sketch}}"}
@ex = se_extrude {"sketch":"{{k.sketch}}","distance":10}
?= ex.volume 10392.305 0.01
# 2) 3D sketch. Arc through (0,0,0), (10,10,0) and (20,0,0): centre (10,0,0), radius 10
@s = se_sketch3d {"action":"create"}
@at = se_sketch3d {"action":"arc_through","sketch":"{{s.handle}}","points":[0,0,0,10,10,0,20,0,0]}
?= at.elements[0].radius 10
?= at.elements[0].center[0] 10
?= at.elements[0].center[1] 0
?= at.elements[0].end[0] 20
! [invalid_argument] se_sketch3d {"action":"arc_through","sketch":"{{s.handle}}","points":[0,0,0,10,0,0,20,0,0]}
# a tangent arc from the end of the line (0,100,0)-(50,100,0) to (50,140,0): a half circle of 20 about (50,120,0), tied by
#   connect and tangent relations
@tl = se_sketch3d {"action":"line","sketch":"{{s.handle}}","points":[0,100,0,50,100,0]}
@ta = se_sketch3d {"action":"tangent_arc","sketch":"{{s.handle}}","elements":["{{tl.elements[0].handle}}"],"points":[50,140,0]}
?= ta.elements[0].radius 20
?= ta.elements[0].center[1] 120
?= ta.elements[0].end[1] 140
?= ta.sketch.relations 2
! [invalid_argument] se_sketch3d {"action":"tangent_arc","sketch":"{{s.handle}}","elements":["{{tl.elements[0].handle}}"],"points":[100,100,0]}
# a rectangle 40 x 20 centred on (0,200,0) in the XY plane: four lines tied by four connect relations
@rc = se_sketch3d {"action":"rectangle","sketch":"{{s.handle}}","points":[0,200,0],"normal":[0,0,1],"width":40,"height":20}
?= rc.sketch.lines 5
?= rc.sketch.relations 6
?= rc.elements[?length=40].length 40
?= rc.elements[?length=20].length 20
! [invalid_argument] se_sketch3d {"action":"rectangle","sketch":"{{s.handle}}","points":[0,200,0],"normal":[0,0,1],"height":20}
# the line mirrored about the XZ plane: y = -100
@mi = se_sketch3d {"action":"mirror","sketch":"{{s.handle}}","elements":["{{tl.elements[0].handle}}"],"plane":"xz"}
?= mi.elements[0].start[1] -100
?= mi.elements[0].end[1] -100
?= mi.sketch.lines 6
# a line 0..100 split at 40: 0..40 and 40..100
@sl = se_sketch3d {"action":"line","sketch":"{{s.handle}}","points":[0,300,0,100,300,0]}
@sp = se_sketch3d {"action":"split","sketch":"{{s.handle}}","elements":["{{sl.elements[0].handle}}"],"points":[40,300,0]}
?= sp.elements[0].length 40
?= sp.elements[1].length 60
# a line 0..100 crossed at x 50 and trimmed at x 80: 0..50 is left
@tr1 = se_sketch3d {"action":"line","sketch":"{{s.handle}}","points":[0,400,0,100,400,0]}
se_sketch3d {"action":"line","sketch":"{{s.handle}}","points":[50,380,0,50,420,0]}
@tr = se_sketch3d {"action":"trim","sketch":"{{s.handle}}","elements":["{{tr1.elements[0].handle}}"],"points":[80,400,0]}
?= tr.elements[0].length 50
# an equation driven curve: x = 100 t, y = 20 sin(pi t), z = 0 for t 0..2, from (0,500,0)
@eq = se_sketch3d {"action":"equation","sketch":"{{s.handle}}","equations":["100*t","500+20*sin(t*pi)","0"],"range":[0,2]}
?= eq.elements[0].start[0] 0
?= eq.elements[0].start[1] 500
?= eq.elements[0].end[0] 200 0.01
! se_sketch3d {"action":"equation","sketch":"{{s.handle}}","equations":["100*t","(","0"],"range":[0,1]}
! [invalid_argument] se_sketch3d {"action":"equation","sketch":"{{s.handle}}","equations":["100*t","0","0"],"range":[1,0]}
# a vertical edge of the hexagonal prism (10 long) included in the sketch
@me = se_geometry {"action":"edges","direction":[0,0,1]}
@in = se_sketch3d {"action":"include","sketch":"{{s.handle}}","edges":["{{me.items[0].handle}}"]}
?= in.elements[0].type line
?= in.elements[0].length 10
! [invalid_argument] se_sketch3d {"action":"include","sketch":"{{s.handle}}"}
@i = se_sketch3d {"action":"info","sketch":"{{s.handle}}"}
?= i.sketch.lines 11
?= i.sketch.arcs 2
se_documents {"action":"close","document":"{{p.handle}}","saveChanges":false}
