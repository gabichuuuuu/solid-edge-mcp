# A69: a part cut by a plane (se_part_feature cut_by_plane): an extruded cutout through all, to one side, of a rectangle drawn
# on the plane around the body. A 100 x 60 x 20 block and a plane 5 mm above its base (z = 5, sketch normal +z): normal removes
# z > 5 and leaves 100 x 60 x 5 = 30000 mm3, reverse removes z < 5 and leaves 90000. Without a side it is refused.
@d = se_documents {"action":"new","kind":"part"}
@k = se_sketch {"action":"create","plane":"1"}
se_sketch {"action":"rectangle","sketch":"{{k.sketch}}","points":[0,0,100,60]}
se_sketch {"action":"close","sketch":"{{k.sketch}}"}
se_extrude {"sketch":"{{k.sketch}}","distance":20}
@pl = se_ref_plane {"action":"offset","plane":"1","distance":5}
! [invalid_argument] se_part_feature {"action":"cut_by_plane","plane":"{{pl.handle}}"}
@c = se_part_feature {"action":"cut_by_plane","plane":"{{pl.handle}}","side":"normal"}
?= c.removedToward[2] 1
?= c.cut.volume 30000 0.01
se_documents {"action":"close","document":"{{d.handle}}","saveChanges":false}
@d2 = se_documents {"action":"new","kind":"part"}
@k2 = se_sketch {"action":"create","plane":"1"}
se_sketch {"action":"rectangle","sketch":"{{k2.sketch}}","points":[0,0,100,60]}
se_sketch {"action":"close","sketch":"{{k2.sketch}}"}
se_extrude {"sketch":"{{k2.sketch}}","distance":20}
@pl2 = se_ref_plane {"action":"offset","plane":"1","distance":5}
@c2 = se_part_feature {"action":"cut_by_plane","plane":"{{pl2.handle}}","side":"reverse"}
?= c2.removedToward[2] -1
?= c2.cut.volume 90000 0.01
se_documents {"action":"close","document":"{{d2.handle}}","saveChanges":false}
