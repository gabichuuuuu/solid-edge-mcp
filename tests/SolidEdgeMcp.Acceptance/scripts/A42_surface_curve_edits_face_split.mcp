# A42: surface edits (se_surface copy, trim, extend, intersect, bluesurf), curve edits (se_curve isocline, split) and face
# splits (se_face_split split, parting, offset_edge), merged faces (se_part_feature redefine_faces), face edits on the
# second body of a split part, with the refusals, and the generic layer's SplitCurves guard.
# Expected values are worked out by hand from the dimensions: block 100 x 60 x 20 (top 6000, front 2000, back 2000 mm2,
# 120000 mm3); walls 100 x 20 (2000) and 80 x 20 (1600); a tube 100 x 60 cut at z = 5 and 15 (100 x 60 x 10 = 60000 mm3);
# BlueSurf between lines 60 apart and 20 higher (100 x sqrt(60^2 + 20^2) = 6324.55532); a sphere of radius 20 (volume
# 4/3 pi 20^3 = 33510.321638, half area 2 pi 20^2 = 2513.274123; at 30 degrees to XY the circles of radius 20 cos 30 =
# 17.320508 at z = +-20 sin 30 = +-10, length 2 pi 17.320508 = 108.827962).
# 1) Block: copy the top and front, split the top at x = 50, a line 10 from the bottom's front edge, the front by a wall at
# x = 30 (600 + 1400), the back by a curve at z = 10 (1000 + 1000); the volume never changes
@pa = se_documents {"action":"new","kind":"part"}
@k = se_sketch {"action":"create","plane":"1"}
se_sketch {"action":"rectangle","sketch":"{{k.sketch}}","points":[0,0,100,60]}
se_sketch {"action":"close","sketch":"{{k.sketch}}"}
se_extrude {"sketch":"{{k.sketch}}","distance":20}
@top = se_geometry {"action":"faces","direction":[0,0,1]}
@front = se_geometry {"action":"faces","direction":[0,-1,0]}
! [invalid_argument] se_surface {"action":"copy"}
@c1 = se_surface {"action":"copy","faces":["{{top.items[0].handle}}","{{front.items[0].handle}}"]}
?= c1.surface.type copy
?= c1.surface.faces 2
?= c1.surface.area 8000 0.001
@rp = se_ref_plane {"action":"offset","plane":"yz","distance":50}
@top2 = se_geometry {"action":"faces","direction":[0,0,1]}
@f1 = se_face_split {"action":"split","faces":["{{top2.items[0].handle}}"],"tools":["{{rp.handle}}"]}
?= f1.feature.type SplitFace
?= f1.facesBefore 6
?= f1.faces 7
?= f1.pieces[0].area 3000 0.001
?= f1.pieces[1].area 3000 0.001
?= f1.volume 120000 0.01
@bot = se_geometry {"action":"faces","direction":[0,0,-1]}
@be = se_geometry {"action":"edges","source":"{{bot.items[0].handle}}","direction":[1,0,0]}
@f2 = se_face_split {"action":"offset_edge","faces":["{{bot.items[0].handle}}"],"edge":"{{be.items[0].handle}}","distance":10}
?= f2.feature.type OffsetEdge
?= f2.faces 8
?= f2.edges[0].length 100 0.001
?= f2.pieces[0].area 1000 0.001
?= f2.pieces[1].area 5000 0.001
?= f2.volume 120000 0.01
@bot2 = se_geometry {"action":"faces","direction":[0,0,-1]}
?= bot2.count 2
@kw = se_sketch {"action":"create","plane":"1"}
se_sketch {"action":"line","sketch":"{{kw.sketch}}","points":[30,-10,30,70]}
se_sketch {"action":"close","sketch":"{{kw.sketch}}","open":true}
@sw = se_surface {"action":"extrude","sketch":"{{kw.sketch}}","depth":30}
@fr = se_geometry {"action":"faces","direction":[0,-1,0]}
@f3 = se_face_split {"action":"split","faces":["{{fr.items[0].handle}}"],"tools":["{{sw.surface.handle}}"]}
?= f3.faces 9
?= f3.pieces[0].area 1400 0.001
?= f3.pieces[1].area 600 0.001
@fr2 = se_geometry {"action":"faces","direction":[0,-1,0]}
?= fr2.count 2
@cu = se_curve {"action":"points","points":[-10,60,10,50,60,10,110,60,10]}
@bk = se_geometry {"action":"faces","direction":[0,1,0]}
@f4 = se_face_split {"action":"split","faces":["{{bk.items[0].handle}}"],"tools":["{{cu.curve.handle}}"]}
?= f4.faces 10
?= f4.pieces[0].area 1000 0.001
?= f4.pieces[1].area 1000 0.001
# Refusals: no tools, a face of the body as tool, a surface face to split, an edge that does not bound the face, a flat face
# has no parting line
@rt = se_geometry {"action":"faces","direction":[1,0,0]}
@lt = se_geometry {"action":"faces","direction":[-1,0,0]}
@le = se_geometry {"action":"edges","source":"{{lt.items[0].handle}}"}
@swf = se_geometry {"action":"faces","source":"{{sw.surface.handle}}"}
! [invalid_argument] se_face_split {"action":"split","faces":["{{rt.items[0].handle}}"]}
! [invalid_argument] se_face_split {"action":"split","faces":["{{rt.items[0].handle}}"],"tools":["{{lt.items[0].handle}}"]}
! [invalid_argument] se_face_split {"action":"split","faces":["{{swf.items[0].handle}}"],"tools":["{{rp.handle}}"]}
! [invalid_argument] se_face_split {"action":"offset_edge","faces":["{{rt.items[0].handle}}"],"edge":"{{le.items[0].handle}}","distance":10}
! [feature_failed] se_face_split {"action":"parting","faces":["{{rt.items[0].handle}}"],"plane":"xy"}
@v1 = se_physical {}
?= v1.volume 120000 0.01
se_documents {"action":"close","saveChanges":false}
# 1b) The same line drawn on the front face from the same edge, 5 mm: Solid Edge puts it on the bottom first, so the tool
# deletes that and draws it on the other side (500 + 1500); the bottom stays whole
@pa2 = se_documents {"action":"new","kind":"part"}
@k2 = se_sketch {"action":"create","plane":"1"}
se_sketch {"action":"rectangle","sketch":"{{k2.sketch}}","points":[0,0,100,60]}
se_sketch {"action":"close","sketch":"{{k2.sketch}}"}
se_extrude {"sketch":"{{k2.sketch}}","distance":20}
@bo = se_geometry {"action":"faces","direction":[0,0,-1]}
@bf = se_geometry {"action":"edges","source":"{{bo.items[0].handle}}","direction":[1,0,0]}
@fo = se_geometry {"action":"faces","direction":[0,-1,0]}
@o2 = se_face_split {"action":"offset_edge","faces":["{{fo.items[0].handle}}"],"edge":"{{bf.items[0].handle}}","distance":5}
?= o2.faces 7
?= o2.pieces[0].area 1500 0.001
?= o2.pieces[1].area 500 0.001
@bo2 = se_geometry {"action":"faces","direction":[0,0,-1]}
?= bo2.count 1
?= bo2.items[0].area 6000 0.001
se_documents {"action":"close","saveChanges":false}
# 2) Trim: the wall y = 30 (2000) by the wall x = 50 at a point on x > 50 (1000 left), then by a curve at z = 10 at a point
# above it (500 left)
@pt = se_documents {"action":"new","kind":"part"}
@ka = se_sketch {"action":"create","plane":"1"}
se_sketch {"action":"line","sketch":"{{ka.sketch}}","points":[0,30,100,30]}
se_sketch {"action":"close","sketch":"{{ka.sketch}}","open":true}
@sa = se_surface {"action":"extrude","sketch":"{{ka.sketch}}","depth":20}
@kb = se_sketch {"action":"create","plane":"1"}
se_sketch {"action":"line","sketch":"{{kb.sketch}}","points":[50,-10,50,70]}
se_sketch {"action":"close","sketch":"{{kb.sketch}}","open":true}
@sb = se_surface {"action":"extrude","sketch":"{{kb.sketch}}","depth":20}
! [invalid_argument] se_surface {"action":"trim","surfaces":["{{sa.surface.handle}}"],"tools":["yz"],"point":[75,30,10]}
! [invalid_argument] se_surface {"action":"trim","surfaces":["{{sa.surface.handle}}"],"tools":["{{sb.surface.handle}}"],"point":[75,40,10]}
! [invalid_argument] se_surface {"action":"trim","surfaces":["{{sa.surface.handle}}","{{sb.surface.handle}}"],"tools":["{{sb.surface.handle}}"],"point":[75,30,10]}
@t1 = se_surface {"action":"trim","surfaces":["{{sa.surface.handle}}"],"tools":["{{sb.surface.handle}}"],"point":[75,30,10]}
?= t1.feature.type TrimSurface
?= t1.surface.area 1000 0.001
?= t1.areaChange -1000 0.001
?= t1.surface.boundingBox.max[0] 50 0.001
@cv = se_curve {"action":"points","points":[-10,30,10,25,30,10,60,30,10]}
@t2 = se_surface {"action":"trim","surfaces":["{{sa.surface.handle}}"],"tools":["{{cv.curve.handle}}"],"point":[25,30,15]}
?= t2.surface.area 500 0.001
?= t2.surface.boundingBox.max[2] 10 0.001
se_documents {"action":"close","saveChanges":false}
# 3) Extend the wall x = 50 (80 x 20 = 1600): its top edge 10 (natural, + 80 x 10), a side edge 10 (linear, now 30 long:
# + 300), the top edge again 5 (reflective, now 90 long: + 450)
@pe = se_documents {"action":"new","kind":"part"}
@kx = se_sketch {"action":"create","plane":"1"}
se_sketch {"action":"line","sketch":"{{kx.sketch}}","points":[50,-10,50,70]}
se_sketch {"action":"close","sketch":"{{kx.sketch}}","open":true}
@sx = se_surface {"action":"extrude","sketch":"{{kx.sketch}}","depth":20}
@ey = se_geometry {"action":"edges","source":"{{sx.surface.handle}}","direction":[0,1,0]}
! [invalid_argument] se_surface {"action":"extend","edges":["{{ey.items[0].handle}}"]}
@x1 = se_surface {"action":"extend","edges":["{{ey.items[0].handle}}"],"distance":10}
?= x1.feature.type ExtendSurface
?= x1.surface.area 2400 0.001
?= x1.areaChange 800 0.001
?= x1.surface.boundingBox.max[2] 30 0.001
@ez = se_geometry {"action":"edges","source":"{{sx.surface.handle}}","direction":[0,0,1]}
@x2 = se_surface {"action":"extend","edges":["{{ez.items[0].handle}}"],"distance":10,"extension":"linear"}
?= x2.surface.area 2700 0.001
?= x2.surface.boundingBox.max[1] 80 0.001
@ey2 = se_geometry {"action":"edges","source":"{{sx.surface.handle}}","direction":[0,1,0]}
@x3 = se_surface {"action":"extend","edges":["{{ey2.items[1].handle}}"],"distance":5,"extension":"reflective"}
?= x3.surface.area 3150 0.001
?= x3.surface.boundingBox.max[2] 35 0.001
se_documents {"action":"close","saveChanges":false}
# 4) Intersect: a tube 100 x 60 x 20 and planes at z = 5 and 15 close into one solid of 100 x 60 x 10
@pi = se_documents {"action":"new","kind":"part"}
@kt = se_sketch {"action":"create","plane":"1"}
se_sketch {"action":"rectangle","sketch":"{{kt.sketch}}","points":[0,0,100,60]}
se_sketch {"action":"close","sketch":"{{kt.sketch}}"}
@tube = se_surface {"action":"extrude","sketch":"{{kt.sketch}}","depth":20}
@kp1 = se_sketch {"action":"create","plane":"xz"}
se_sketch {"action":"line","sketch":"{{kp1.sketch}}","points":[-10,5,110,5]}
se_sketch {"action":"close","sketch":"{{kp1.sketch}}","open":true}
@pl1 = se_surface {"action":"extrude","sketch":"{{kp1.sketch}}","depth":200,"direction":"symmetric"}
@kp2 = se_sketch {"action":"create","plane":"xz"}
se_sketch {"action":"line","sketch":"{{kp2.sketch}}","points":[-10,15,110,15]}
se_sketch {"action":"close","sketch":"{{kp2.sketch}}","open":true}
@pl2 = se_surface {"action":"extrude","sketch":"{{kp2.sketch}}","depth":200,"direction":"symmetric"}
! [invalid_argument] se_surface {"action":"intersect","surfaces":["{{tube.surface.handle}}"]}
@i1 = se_surface {"action":"intersect","surfaces":["{{tube.surface.handle}}","{{pl1.surface.handle}}","{{pl2.surface.handle}}"]}
?= i1.feature.type IntersectSurface
?= i1.body.kind solid
?= i1.body.volume 60000 0.01
?= i1.body.faces 6
?= i1.body.boundingBox.min[2] 5 0.001
?= i1.body.boundingBox.max[2] 15 0.001
@li = se_surface {"action":"list"}
?= li.count 4
?= li.surfaces[3].type intersect
se_documents {"action":"close","saveChanges":false}
# 5) BlueSurf between a line at y = 0, z = 0 and one at y = 60, z = 20 drawn the other way, then with a straight guide; a
# circle as a section is refused
@pb = se_documents {"action":"new","kind":"part"}
@cu1 = se_curve {"action":"points","points":[0,0,0,50,0,0,100,0,0]}
@cu2 = se_curve {"action":"points","points":[100,60,20,50,60,20,0,60,20]}
@e1 = se_geometry {"action":"edges","source":"{{cu1.curve.handle}}"}
@e2 = se_geometry {"action":"edges","source":"{{cu2.curve.handle}}"}
! [invalid_argument] se_surface {"action":"bluesurf","edges":["{{e1.items[0].handle}}"]}
@b1 = se_surface {"action":"bluesurf","edges":["{{e1.items[0].handle}}","{{e2.items[0].handle}}"]}
?= b1.surface.type bluesurf
?= b1.surface.area 6324.55532 0.001
@cug = se_curve {"action":"points","points":[0,0,0,0,30,10,0,60,20]}
@e1b = se_geometry {"action":"edges","source":"{{cu1.curve.handle}}"}
@e2b = se_geometry {"action":"edges","source":"{{cu2.curve.handle}}"}
@eg = se_geometry {"action":"edges","source":"{{cug.curve.handle}}"}
@b2 = se_surface {"action":"bluesurf","edges":["{{e1b.items[0].handle}}","{{e2b.items[0].handle}}"],"guides":["{{eg.items[0].handle}}"]}
?= b2.surface.area 6324.55532 0.001
# A full circle (the edge of a cylinder) has no vertex to start a section from: refused
se_primitive {"shape":"cylinder","plane":"1","center":[0,-60,0],"radius":20,"depth":30}
@ce = se_geometry {"action":"edges"}
@e1c = se_geometry {"action":"edges","source":"{{cu1.curve.handle}}"}
! [invalid_argument] se_surface {"action":"bluesurf","edges":["{{ce.items[0].handle}}","{{e1c.items[0].handle}}"]}
se_documents {"action":"close","saveChanges":false}
# 6) Sphere of radius 20: isoclines at 30 degrees to XY on both sides, and the parting split at XY into two halves
@ps = se_documents {"action":"new","kind":"part"}
se_primitive {"shape":"sphere","center":[0,0,0],"radius":20}
@sph = se_geometry {"action":"faces"}
! [invalid_argument] se_curve {"action":"isocline","faces":["{{sph.items[0].handle}}"],"plane":"xy","angle":90}
@i1 = se_curve {"action":"isocline","faces":["{{sph.items[0].handle}}"],"plane":"xy","angle":30}
?= i1.curve.type isocline
?= i1.curve.length 108.827962 0.001
?= i1.curve.boundingBox.min[2] 10 0.001
?= i1.curve.boundingBox.max[0] 17.320508 0.001
@sph2 = se_geometry {"action":"faces"}
@i2 = se_curve {"action":"isocline","faces":["{{sph2.items[0].handle}}"],"plane":"xy","angle":30,"direction":"reverse"}
?= i2.curve.length 108.827962 0.001
?= i2.curve.boundingBox.max[2] -10 0.001
@sph3 = se_geometry {"action":"faces"}
@pp = se_face_split {"action":"parting","faces":["{{sph3.items[0].handle}}"],"plane":"xy"}
?= pp.feature.type PartingSplit
?= pp.faces 2
?= pp.pieces[0].area 2513.274123 0.001
?= pp.pieces[1].area 2513.274123 0.001
?= pp.volume 33510.321638 0.01
se_documents {"action":"close","saveChanges":false}
# 7) Split a curve 0..100 along x at x = 40 (60 + 40), again where a curve at x = 70 crosses it (30 + 30 + 40), then by
# planes at x = 10 and 85 that cross two different edges (5 edges); its length stays 100. Refusals (a plane through a vertex,
# the curve itself, a curve running along it), then a curve at x = 15 and an edge of a curve at x = 55 in one call: two
# splits, the second with the tool edge taken again (7 edges). A curved curve split where another one crosses it keeps its
# length. The guard of SplitCurves in the generic layer.
@pc = se_documents {"action":"new","kind":"part"}
@cl = se_curve {"action":"points","points":[0,0,0,50,0,0,100,0,0]}
@r40 = se_ref_plane {"action":"offset","plane":"yz","distance":40}
@s1 = se_curve {"action":"split","curve":"{{cl.curve.handle}}","tools":["{{r40.handle}}"]}
?= s1.features[0].type SplitCurve
?= s1.curve.edges 2
?= s1.pieces[0] 60 0.001
?= s1.pieces[1] 40 0.001
@cx = se_curve {"action":"points","points":[70,-20,0,70,0,0,70,20,0]}
@s2 = se_curve {"action":"split","curve":"{{cl.curve.handle}}","tools":["{{cx.curve.handle}}"]}
?= s2.curve.edges 3
?= s2.curve.length 100 0.001
@r10 = se_ref_plane {"action":"offset","plane":"yz","distance":10}
@r85 = se_ref_plane {"action":"offset","plane":"yz","distance":85}
@s3 = se_curve {"action":"split","curve":"{{cl.curve.handle}}","tools":["{{r10.handle}}","{{r85.handle}}","{{cx.curve.handle}}"]}
?= s3.features[1].type SplitCurve
?= s3.curve.edges 5
?= s3.curve.length 100 0.001
@r150 = se_ref_plane {"action":"offset","plane":"yz","distance":150}
! [invalid_argument] se_curve {"action":"split","curve":"{{cl.curve.handle}}","tools":["{{r150.handle}}"]}
! [invalid_argument] se_curve {"action":"split","curve":"{{cl.curve.handle}}","tools":["{{r40.handle}}"]}
! [invalid_argument] se_curve {"action":"split","curve":"{{cl.curve.handle}}","tools":["{{cl.curve.handle}}"]}
@ca = se_curve {"action":"points","points":[25,0,0,50,0,0,75,0,0]}
! [invalid_argument] se_curve {"action":"split","curve":"{{cl.curve.handle}}","tools":["{{ca.curve.handle}}"]}
@c15 = se_curve {"action":"points","points":[15,-20,0,15,0,0,15,20,0]}
@c55 = se_curve {"action":"points","points":[55,-20,0,55,0,0,55,20,0]}
@e55 = se_geometry {"action":"edges","source":"{{c55.curve.handle}}"}
@s5 = se_curve {"action":"split","curve":"{{cl.curve.handle}}","tools":["{{c15.curve.handle}}","{{e55.items[0].handle}}"]}
?= s5.features[1].type SplitCurve
?= s5.curve.edges 7
?= s5.curve.length 100 0.001
@ex = se_geometry {"action":"edges","source":"{{cx.curve.handle}}"}
@vx = se_com_get {"target":"{{ex.items[0].handle}}","member":"EndVertex"}
! [handle_wrong_type] se_curve {"action":"split","curve":"{{cl.curve.handle}}","tools":["{{vx.value.handle}}"]}
! [handle_wrong_type] se_curve {"action":"split","curve":"{{ex.items[0].handle}}","tools":["{{r40.handle}}"]}
@cs = se_com_get {"target":"active_document","member":"Constructions"}
@cm = se_com_invoke {"target":"{{cs.value.handle}}","method":"Item","arguments":[1]}
@scs = se_com_get {"target":"{{cm.result.handle}}","member":"SplitCurves"}
! [unsafe_member] se_com_invoke {"target":"{{scs.value.handle}}","method":"AreCurvesValid","arguments":[1,{"type":"object[]","value":[{"handle":"{{cx.curve.handle}}"}]}]}
! [unsafe_member] se_com_invoke {"target":"{{scs.value.handle}}","method":"Add","arguments":[1,{"type":"object[]","value":[{"handle":"{{cx.curve.handle}}"}]},1,{"type":"object[]","value":[{"handle":"{{r40.handle}}"}]}]}
@el = se_geometry {"action":"edges","source":"{{cl.curve.handle}}"}
! [unsafe_member] se_com_invoke {"target":"{{scs.value.handle}}","method":"Add","arguments":[2,{"type":"object[]","value":[{"handle":"{{el.items[0].handle}}"},{"handle":"{{el.items[1].handle}}"}]},1,{"type":"object[]","value":[{"handle":"{{r40.handle}}"}]}]}
@valid = se_com_invoke {"target":"{{scs.value.handle}}","method":"AreCurvesValid","arguments":[1,{"type":"object[]","value":[{"handle":"{{ex.items[0].handle}}"}]}]}
?~ valid.result true
@cc = se_curve {"action":"points","points":[0,50,0,50,80,0,100,50,0]}
@cd = se_curve {"action":"points","points":[30,40,0,40,70,0,60,100,0]}
@s4 = se_curve {"action":"split","curve":"{{cc.curve.handle}}","tools":["{{cd.curve.handle}}"]}
?= s4.curve.edges 2
?= s4.curve.length {{cc.curve.length}} 0.00001
se_documents {"action":"close","saveChanges":false}
# 8) Redefine faces: after a round of radius 5 along the top front edge (volume 120000 - (1 - pi/4) 5^2 100 = 119463.495408)
# the top (5500) and the round (pi 5 / 2 x 100 = 785.398163) become one B-spline face of 6285.398 mm2, 7 faces to 6, within
# the fit of the B-spline; then that face and the front (1500) one face, 5 faces, but that fit no longer follows the faces:
# a warning, and deleting it brings the 6 faces back. One face, or faces apart, are refused.
@pr = se_documents {"action":"new","kind":"part"}
@kr = se_sketch {"action":"create","plane":"1"}
se_sketch {"action":"rectangle","sketch":"{{kr.sketch}}","points":[0,0,100,60]}
se_sketch {"action":"close","sketch":"{{kr.sketch}}"}
se_extrude {"sketch":"{{kr.sketch}}","distance":20}
@er = se_geometry {"action":"edges","direction":[1,0,0]}
se_round {"edges":["{{er.items[?start=[0,0,20]].handle}}"],"radius":5}
@fr8 = se_geometry {"action":"faces"}
@tr8 = se_geometry {"action":"faces","direction":[0,0,1]}
@br8 = se_geometry {"action":"faces","direction":[0,0,-1]}
@ft8 = se_geometry {"action":"faces","direction":[0,-1,0]}
! [invalid_argument] se_part_feature {"action":"redefine_faces","faces":["{{tr8.items[0].handle}}"]}
! [invalid_argument] se_part_feature {"action":"redefine_faces","faces":["{{tr8.items[0].handle}}","{{br8.items[0].handle}}"]}
@rd = se_part_feature {"action":"redefine_faces","faces":["{{tr8.items[0].handle}}","{{fr8.items[?type="cylinder"].handle}}"]}
?= rd.facesBefore 7
?= rd.faces 6
?= rd.merged[0].area 6285.398163 0.1
?= rd.volume 119463.495408 1
@al8 = se_geometry {"action":"faces"}
?= al8.items[?type="spline"].area 6285.398163 0.1
@ft9 = se_geometry {"action":"faces","direction":[0,-1,0]}
@rd2 = se_part_feature {"action":"redefine_faces","faces":["{{rd.merged[0].handle}}","{{ft9.items[0].handle}}"]}
?= rd2.faces 5
?= rd2.merged[0].area 7785.398163 0.2
?~ rd2.warnings B-spline fitted
se_feature_edit {"action":"delete","feature":"{{rd2.feature.handle}}"}
@s8 = se_geometry {"action":"summary"}
?= s8.faces 6
?= s8.volume 119463.495408 1
se_documents {"action":"close","saveChanges":false}
# 8b) The same round on a block split at x = 30 into two design bodies: the top (30 x 55 = 1650) and the round
# (pi 5 / 2 x 30 = 235.619449) of the second body (x 0 to 30) become one face of 1885.619449 mm2
@pr2 = se_documents {"action":"new","kind":"part"}
@kr2 = se_sketch {"action":"create","plane":"1"}
se_sketch {"action":"rectangle","sketch":"{{kr2.sketch}}","points":[0,0,100,60]}
se_sketch {"action":"close","sketch":"{{kr2.sketch}}"}
se_extrude {"sketch":"{{kr2.sketch}}","distance":20}
@er2 = se_geometry {"action":"edges","direction":[1,0,0]}
se_round {"edges":["{{er2.items[?start=[0,0,20]].handle}}"],"radius":5}
@p30 = se_ref_plane {"action":"offset","plane":"2","distance":30}
@sp = se_part_feature {"action":"split","plane":"{{p30.handle}}"}
?= sp.bodies[1].boundingBox.max[0] 30 0.001
@bf = se_geometry {"action":"faces","source":"{{sp.bodies[1].handle}}"}
@bt = se_geometry {"action":"faces","source":"{{sp.bodies[1].handle}}","direction":[0,0,1]}
@rb = se_part_feature {"action":"redefine_faces","faces":["{{bt.items[0].handle}}","{{bf.items[?type="cylinder"].handle}}"]}
?= rb.facesBefore 7
?= rb.faces 6
?= rb.merged[0].area 1885.619449 0.1
?= rb.volume 119463.495408 1
se_documents {"action":"close","saveChanges":false}
# 8c) Face edits on the second body of the same split part: its round resized to r8 (- (1 - pi/4)(8^2 - 5^2) 30 =
# -251.084149) and deleted (the body back to 30 x 60 x 20 = 36000, the part 83624.446786 + 36000), its top offset 5 mm
# (+9000) and replaced by a plane at z = 30 (+9000); faces of two bodies in one call are refused
@pr3 = se_documents {"action":"new","kind":"part"}
@kr3 = se_sketch {"action":"create","plane":"1"}
se_sketch {"action":"rectangle","sketch":"{{kr3.sketch}}","points":[0,0,100,60]}
se_sketch {"action":"close","sketch":"{{kr3.sketch}}"}
se_extrude {"sketch":"{{kr3.sketch}}","distance":20}
@er3 = se_geometry {"action":"edges","direction":[1,0,0]}
se_round {"edges":["{{er3.items[?start=[0,0,20]].handle}}"],"radius":5}
@q30 = se_ref_plane {"action":"offset","plane":"2","distance":30}
@sq = se_part_feature {"action":"split","plane":"{{q30.handle}}"}
@g0 = se_geometry {"action":"faces","source":"{{sq.bodies[0].handle}}","direction":[0,0,1]}
@g1 = se_geometry {"action":"faces","source":"{{sq.bodies[1].handle}}","direction":[0,0,1]}
! [invalid_argument] se_part_feature {"action":"offset_faces","faces":["{{g0.items[0].handle}}","{{g1.items[0].handle}}"],"distance":5}
@gf = se_geometry {"action":"faces","source":"{{sq.bodies[1].handle}}"}
@rr = se_part_feature {"action":"resize_rounds","faces":["{{gf.items[?type="cylinder"].handle}}"],"radius":8}
?= rr.volume 119212.411259 0.01
@q2 = se_geometry {"action":"summary"}
@gf2 = se_geometry {"action":"faces","source":"{{q2.bodies[1].handle}}"}
@dr = se_part_feature {"action":"delete_rounds","faces":["{{gf2.items[?type="cylinder"].handle}}"]}
?= dr.volume 119624.446786 0.01
@q3 = se_geometry {"action":"summary"}
?= q3.bodies[1].volume 36000 0.01
@gt3 = se_geometry {"action":"faces","source":"{{q3.bodies[1].handle}}","direction":[0,0,1]}
@of = se_part_feature {"action":"offset_faces","faces":["{{gt3.items[0].handle}}"],"distance":5}
?= of.volume 128624.446786 0.01
@z30 = se_ref_plane {"action":"offset","plane":"xy","distance":30}
@q4 = se_geometry {"action":"summary"}
@gt4 = se_geometry {"action":"faces","source":"{{q4.bodies[1].handle}}","direction":[0,0,1]}
@rf = se_part_feature {"action":"replace_faces","faces":["{{gt4.items[0].handle}}"],"replaceWith":"{{z30.handle}}"}
?= rf.volume 137624.446786 0.01
@q5 = se_geometry {"action":"summary"}
?= q5.bodies[1].volume 54000 0.01
?= q5.bodies[1].boundingBox.max[2] 30 0.001
se_documents {"action":"close","saveChanges":false}
