# A03: part features with hand-calculated volumes
# R: revolve of a 20x40 rectangle in XZ around its side x=0 -> cylinder r20 h40 = pi*400*40 = 50265.482
@dR = se_documents {"action":"new","kind":"part"}
@kR = se_sketch {"action":"create","plane":"3"}
@rR = se_sketch {"action":"rectangle","sketch":"{{kR.sketch}}","points":[0,0,20,40]}
@aR = se_sketch {"action":"axis","sketch":"{{kR.sketch}}","element":"{{rR.elements[3]}}"}
se_sketch {"action":"close","sketch":"{{kR.sketch}}"}
@vR = se_revolve {"sketch":"{{kR.sketch}}","axis":"{{aR.axis}}"}
?= vR.volume 50265.482 0.01
# r3 fillet on the upper circular edge: -2*pi*19.32990*1.931417 = -234.578 -> 50030.904
@cR = se_geometry {"action":"edges","type":"circle"}
@ro = se_round {"edges":["{{cR.items[?center=[0,0,40]].handle}}"],"radius":3}
?= ro.volume 50030.904 0.05
# chamfer 2 on the lower circular edge: -2*pi*19.33333*2 = -242.950 -> 49787.954
@cR2 = se_geometry {"action":"edges","type":"circle"}
@ch = se_chamfer {"edges":["{{cR2.items[?center=[0,0,0]].handle}}"],"distance":2}
?= ch.volume 49787.954 0.05
# partial revolve cut: rectangle x 5..25, z 15..25 rotated 90° around the Z axis -> -(pi*(20^2-5^2)/4)*10 = -2945.243
@kR3 = se_sketch {"action":"create","plane":"3"}
@rR3 = se_sketch {"action":"rectangle","sketch":"{{kR3.sketch}}","points":[5,15,25,25]}
@lR3 = se_sketch {"action":"line","sketch":"{{kR3.sketch}}","points":[0,0,0,40]}
@aR3 = se_sketch {"action":"axis","sketch":"{{kR3.sketch}}","element":"{{lR3.element}}"}
se_sketch {"action":"close","sketch":"{{kR3.sketch}}"}
@cut = se_revolve {"sketch":"{{kR3.sketch}}","axis":"{{aR3.axis}}","operation":"cut","angle":90}
?= cut.volumeChange -2945.243 0.05
se_documents {"action":"close","document":"{{dR.handle}}","saveChanges":false}
# S: shell with 2 mm walls, open at the top, on a 50x50x30 box -> 75000 - 46*46*28 = 15752
@dS = se_documents {"action":"new","kind":"part"}
@kS = se_sketch {"action":"create","plane":"1"}
se_sketch {"action":"rectangle","sketch":"{{kS.sketch}}","points":[0,0,50,50]}
se_sketch {"action":"close","sketch":"{{kS.sketch}}"}
se_extrude {"sketch":"{{kS.sketch}}","distance":30}
@tS = se_geometry {"action":"faces","direction":[0,0,1]}
@sh = se_shell {"thickness":2,"openFaces":["{{tS.items[0].handle}}"]}
?= sh.volume 15752 0.01
se_documents {"action":"close","document":"{{dS.handle}}","saveChanges":false}
# D: 5° draft of the four side faces of a 40x40x20 box from below -> frustum: 20/3*(1600+a^2+40a), a=40-40*tan5 = 36.500489 -> 29282.04
@dD = se_documents {"action":"new","kind":"part"}
@kD = se_sketch {"action":"create","plane":"1"}
se_sketch {"action":"rectangle","sketch":"{{kD.sketch}}","points":[0,0,40,40]}
se_sketch {"action":"close","sketch":"{{kD.sketch}}"}
se_extrude {"sketch":"{{kD.sketch}}","distance":20}
@f1 = se_geometry {"action":"faces","direction":[1,0,0]}
@f2 = se_geometry {"action":"faces","direction":[-1,0,0]}
@f3 = se_geometry {"action":"faces","direction":[0,1,0]}
@f4 = se_geometry {"action":"faces","direction":[0,-1,0]}
@dr = se_draft {"plane":"1","faces":["{{f1.items[0].handle}}","{{f2.items[0].handle}}","{{f3.items[0].handle}}","{{f4.items[0].handle}}"],"angle":5}
?= dr.volume 29282.0 0.5
se_documents {"action":"close","document":"{{dD.handle}}","saveChanges":false}
# P: plate 100x60x10; r5 hole at (10,10) by a through cut; pattern 3x2 every 30/40 -> 60000 - 6*785.398 = 55287.611
@dP = se_documents {"action":"new","kind":"part"}
@kP = se_sketch {"action":"create","plane":"1"}
se_sketch {"action":"rectangle","sketch":"{{kP.sketch}}","points":[0,0,100,60]}
se_sketch {"action":"close","sketch":"{{kP.sketch}}"}
se_extrude {"sketch":"{{kP.sketch}}","distance":10}
@kP2 = se_sketch {"action":"create","plane":"1"}
se_sketch {"action":"circle","sketch":"{{kP2.sketch}}","center":[10,10],"radius":5}
se_sketch {"action":"close","sketch":"{{kP2.sketch}}"}
@cP = se_extrude {"sketch":"{{kP2.sketch}}","operation":"cut","extent":"through_all"}
?= cP.volume 59214.602 0.01
@pr = se_pattern {"type":"rectangular","features":["{{cP.feature.handle}}"],"plane":"1","countX":3,"countY":2,"spacingX":30,"spacingY":40}
?= pr.volume 55287.611 0.01
# mirror of the original hole about the plane x=50 -> hole at (90,10): 54502.212
@mp = se_ref_plane {"action":"offset","plane":"2","distance":50}
@mi = se_pattern {"type":"mirror","features":["{{cP.feature.handle}}"],"plane":"{{mp.handle}}"}
?= mi.volume 54502.212 0.01
! [invalid_argument] se_pattern {"type":"rectangular","features":["{{cP.feature.handle}}"],"plane":"1","countX":2,"countY":1}
se_documents {"action":"close","document":"{{dP.handle}}","saveChanges":false}
# C: disc r40 h10 with an r4 hole at (25,0) and a circular pattern of 6 -> 50265.482 - 6*502.655 = 47249.553
@dC = se_documents {"action":"new","kind":"part"}
@kC = se_sketch {"action":"create","plane":"1"}
se_sketch {"action":"circle","sketch":"{{kC.sketch}}","center":[0,0],"radius":40}
se_sketch {"action":"close","sketch":"{{kC.sketch}}"}
se_extrude {"sketch":"{{kC.sketch}}","distance":10}
@kC2 = se_sketch {"action":"create","plane":"1"}
se_sketch {"action":"circle","sketch":"{{kC2.sketch}}","center":[25,0],"radius":4}
se_sketch {"action":"close","sketch":"{{kC2.sketch}}"}
@cC = se_extrude {"sketch":"{{kC2.sketch}}","operation":"cut","extent":"through_all"}
@pc = se_pattern {"type":"circular","features":["{{cC.feature.handle}}"],"plane":"1","count":6}
?= pc.volume 47249.553 0.01
se_documents {"action":"close","document":"{{dC.handle}}","saveChanges":false}
# H: holes of all types in a 100x60x20 block
@dH = se_documents {"action":"new","kind":"part"}
@kH = se_sketch {"action":"create","plane":"1"}
se_sketch {"action":"rectangle","sketch":"{{kH.sketch}}","points":[0,0,100,60]}
se_sketch {"action":"close","sketch":"{{kH.sketch}}"}
@bH = se_extrude {"sketch":"{{kH.sketch}}","distance":20}
@tH = se_geometry {"action":"faces","direction":[0,0,1]}
# Ø6 countersink at 90° with a Ø12 through hole: -(pi*9*20 + cone from Ø12 to Ø6 over 3 mm: pi*3/3*(36+9+18) - pi*9*3) = -(565.487+197.920-84.823) = -678.584
@h1 = se_hole {"plane":"{{tH.items[0].handle}}","centers":[20,30,20],"type":"countersink","diameter":6,"countersinkDiameter":12}
?= h1.volumeChange -678.584 0.05
@tH2 = se_geometry {"action":"faces","direction":[0,0,1]}
# Ø6 counterbore with Ø11 x 6 deep: -(pi*9*14 + pi*30.25*6) = -(395.841+570.199) = -966.040
@h2 = se_hole {"plane":"{{tH2.items[0].handle}}","centers":[50,30,20],"type":"counterbore","diameter":6,"counterboreDiameter":11,"counterboreDepth":6}
?= h2.volumeChange -966.040 0.05
@tH3 = se_geometry {"action":"faces","direction":[0,0,1]}
# M6 thread (5 mm drill) finite 12 mm from the top: cylinder -pi*6.25*12 = -235.619 plus the conical drill tip if there is one
@h3 = se_hole {"plane":"{{tH3.items[0].handle}}","centers":[80,30,20],"type":"tapped","thread":"M6","extent":"finite","depth":12}
?= h3.volumeChange -235.619 0.01
@hd3 = se_com_get {"target":"{{h3.feature.handle}}","member":"HoleData"}
@tdm = se_com_get {"target":"{{hd3.value.handle}}","member":"ThreadDescription"}
?= tdm.value M6x1
@tH4 = se_geometry {"action":"faces","direction":[0,0,1]}
! se_hole {"plane":"{{tH4.items[0].handle}}","centers":[500,500,20],"diameter":5}
@ph = se_physical {}
@ftH = se_feature_tree {}
se_documents {"action":"close","document":"{{dH.handle}}","saveChanges":false}
# F: reference planes. Symmetric 100x100x40 block (z -20..20) = 400000; cylinder r10 h10 on the plane z=20 -> +3141.593, box z -20..30
@dF = se_documents {"action":"new","kind":"part"}
@kB = se_sketch {"action":"create","plane":"1"}
se_sketch {"action":"rectangle","sketch":"{{kB.sketch}}","points":[-50,-50,50,50]}
se_sketch {"action":"close","sketch":"{{kB.sketch}}"}
@eB = se_extrude {"sketch":"{{kB.sketch}}","distance":40,"direction":"symmetric"}
?= eB.volume 400000 0.01
@rp = se_ref_plane {"action":"offset","plane":"1","distance":20}
@ra = se_ref_plane {"action":"angle","plane":"1","pivot":"2","angle":30}
@rl = se_ref_plane {"action":"list"}
@kF = se_sketch {"action":"create","plane":"{{rp.handle}}"}
se_sketch {"action":"circle","sketch":"{{kF.sketch}}","center":[0,0],"radius":10}
se_sketch {"action":"close","sketch":"{{kF.sketch}}"}
@eF = se_extrude {"sketch":"{{kF.sketch}}","distance":10}
?= eF.volumeChange 3141.593 0.01
@gF = se_geometry {"action":"summary"}
?= gF.boundingBox.min[2] -20
?= gF.boundingBox.max[2] 30
# symmetric cut of 10 mm from the plane at 30°: whole r5 cylinder inside the block -> -785.398
@kF2 = se_sketch {"action":"create","plane":"{{ra.handle}}"}
se_sketch {"action":"circle","sketch":"{{kF2.sketch}}","center":[20,0],"radius":5}
se_sketch {"action":"close","sketch":"{{kF2.sketch}}"}
@eF2 = se_extrude {"sketch":"{{kF2.sketch}}","operation":"cut","distance":10,"direction":"symmetric"}
?= eF2.volumeChange -785.398 0.01
se_documents {"action":"close","document":"{{dF.handle}}","saveChanges":false}
# L: square 40 loft -> circle r15 at 50 mm (56453.84); sweep (7263.08); helix (3948.50)
@dL = se_documents {"action":"new","kind":"part"}
@a = se_sketch {"action":"create","plane":"1"}
se_sketch {"action":"rectangle","sketch":"{{a.sketch}}","points":[-20,-20,20,20]}
se_sketch {"action":"close","sketch":"{{a.sketch}}"}
@r = se_ref_plane {"action":"offset","plane":"1","distance":50}
@b = se_sketch {"action":"create","plane":"{{r.handle}}"}
se_sketch {"action":"circle","sketch":"{{b.sketch}}","center":[0,0],"radius":15}
se_sketch {"action":"close","sketch":"{{b.sketch}}"}
@lo = se_loft_sweep {"action":"loft","sketches":["{{a.sketch}}","{{b.sketch}}"]}
?= lo.volume 56453.84 0.05
se_documents {"action":"close","document":"{{dL.handle}}","saveChanges":false}
@dW = se_documents {"action":"new","kind":"part"}
@p = se_sketch {"action":"create","plane":"3"}
se_sketch {"action":"polyline","sketch":"{{p.sketch}}","points":[0,0,0,50,30,80],"closed":false}
se_sketch {"action":"close","sketch":"{{p.sketch}}","open":true}
@s = se_sketch {"action":"create","plane":"1"}
se_sketch {"action":"circle","sketch":"{{s.sketch}}","center":[0,0],"radius":5}
se_sketch {"action":"close","sketch":"{{s.sketch}}"}
@sw = se_loft_sweep {"action":"sweep","sketches":["{{s.sketch}}"],"path":"{{p.sketch}}"}
?= sw.volume 7263.08 0.05
se_documents {"action":"close","document":"{{dW.handle}}","saveChanges":false}
@dX = se_documents {"action":"new","kind":"part"}
@h = se_sketch {"action":"create","plane":"3"}
se_sketch {"action":"circle","sketch":"{{h.sketch}}","center":[10,3],"radius":2}
@hl = se_sketch {"action":"line","sketch":"{{h.sketch}}","points":[0,0,0,40]}
@ha = se_sketch {"action":"axis","sketch":"{{h.sketch}}","element":"{{hl.element}}"}
se_sketch {"action":"close","sketch":"{{h.sketch}}"}
@hx = se_loft_sweep {"action":"helix","sketches":["{{h.sketch}}"],"axis":"{{ha.axis}}","pitch":8,"turns":5}
?= hx.volume 3948.50 0.05
se_documents {"action":"close","document":"{{dX.handle}}","saveChanges":false}
# Other part features (se_part_feature). Rib: L section (80x10 + 10x50) extruded 60 symmetric = 78000; the line (10,40)-(50,10)
#   closes the triangle (10,10)-(10,40)-(50,10) of area 600 with the inner corner, 6 thick -> +3600. Its distance to the corner
#   is 24, so a 10 deep rib leaves out a similar triangle of height 14: 600*(1-(14/24)^2)*6 = +2375. A rib to one side of the
#   plane has the same volume
@dB = se_documents {"action":"new","kind":"part"}
@kB = se_sketch {"action":"create","plane":"3"}
se_sketch {"action":"polyline","sketch":"{{kB.sketch}}","points":[0,0,80,0,80,10,10,10,10,60,0,60],"closed":true}
se_sketch {"action":"close","sketch":"{{kB.sketch}}"}
@eB = se_extrude {"sketch":"{{kB.sketch}}","distance":60,"direction":"symmetric"}
?= eB.volume 78000 0.01
@kr = se_sketch {"action":"create","plane":"3"}
se_sketch {"action":"line","sketch":"{{kr.sketch}}","points":[10,40,50,10]}
se_sketch {"action":"close","sketch":"{{kr.sketch}}","open":true}
@rb = se_part_feature {"action":"rib","sketch":"{{kr.sketch}}","thickness":6}
?= rb.volumeChange 3600 0.01
se_feature_edit {"action":"delete","feature":"{{rb.feature.handle}}"}
@rb2 = se_part_feature {"action":"rib","sketch":"{{kr.sketch}}","thickness":6,"side":"normal"}
?= rb2.volumeChange 3600 0.01
se_feature_edit {"action":"delete","feature":"{{rb2.feature.handle}}"}
@rb3 = se_part_feature {"action":"rib","sketch":"{{kr.sketch}}","thickness":6,"depth":10}
?= rb3.volumeChange 2375 0.01
! [invalid_argument] se_part_feature {"action":"rib","thickness":6}
se_documents {"action":"close","document":"{{dB.handle}}","saveChanges":false}
# Thicken the top face of a 50x50x10 block by 5 -> +12500 = 37500 (inwards a solid gains nothing: 'reverse' fails, and the
#   failed attempt expires the face handles);
#   mirror the body about YZ (x = 0, a face of the block) -> 75000
@dT = se_documents {"action":"new","kind":"part"}
@kT = se_sketch {"action":"create","plane":"1"}
se_sketch {"action":"rectangle","sketch":"{{kT.sketch}}","points":[0,0,50,50]}
se_sketch {"action":"close","sketch":"{{kT.sketch}}"}
se_extrude {"sketch":"{{kT.sketch}}","distance":10}
@fT = se_geometry {"action":"faces","type":"plane","direction":[0,0,1]}
! [feature_failed] se_part_feature {"action":"thicken","faces":["{{fT.items[0].handle}}"],"thickness":5,"side":"reverse"}
@fT2 = se_geometry {"action":"faces","type":"plane","direction":[0,0,1]}
@th = se_part_feature {"action":"thicken","faces":["{{fT2.items[0].handle}}"],"thickness":5}
?= th.volumeChange 12500 0.01
?= th.direction normal
@mb = se_part_feature {"action":"mirror_body","plane":"2"}
?= mb.volume 75000 0.01
@sT = se_geometry {"action":"summary"}
?= sT.boundingBox.size[0] 100
se_documents {"action":"close","document":"{{dT.handle}}","saveChanges":false}
# G: more reference planes and coordinate systems. Block 100x60x20 with a hole Ø20 at (50,30). Plane through the corners
# (0,0,0), (100,0,20), (0,60,20): normal ±(-1200,-2000,6000)/6437.391 = ±(-0.18641,-0.31068,0.93205); mid plane z=10;
# planes normal to the edge y=0, z=20 at its end (x=100) and 30 mm from either end (x=30, x=70); tangent to the hole
# parallel to YZ at x=60 and x=40; a coordinate system at (10,20,30) turned 90° about Z.
@dG = se_documents {"action":"new","kind":"part"}
@kG = se_sketch {"action":"create","plane":"1"}
se_sketch {"action":"rectangle","sketch":"{{kG.sketch}}","points":[0,0,100,60]}
se_sketch {"action":"close","sketch":"{{kG.sketch}}"}
se_extrude {"sketch":"{{kG.sketch}}","distance":20}
@tG = se_geometry {"action":"faces","direction":[0,0,1]}
@bG = se_geometry {"action":"faces","direction":[0,0,-1]}
@p3 = se_ref_plane {"action":"three_points","points":[0,0,0,100,0,20,0,60,20]}
?= p3.normal[2] 0.93205 0.0001
?= p3.normal[0] -0.18641 0.0001
! [invalid_argument] se_ref_plane {"action":"three_points","points":[0,0,0,100,0,20,10,10,10]}
! [invalid_argument] se_ref_plane {"action":"three_points","points":[0,0,0,50,0,0,100,0,0]}
@mid = se_ref_plane {"action":"mid","plane":"{{bG.items[0].handle}}","plane2":"{{tG.items[0].handle}}"}
?= mid.rootPoint[2] 10
?= mid.normal[2] -1
! [invalid_argument] se_ref_plane {"action":"mid","plane":"1","plane2":"2"}
@eG = se_geometry {"action":"edges","limit":20}
@n1 = se_ref_plane {"action":"normal_to_edge","edge":"{{eG.items[?end=[100,0,20]].handle}}","at":"end"}
?= n1.rootPoint[0] 100
?= n1.normal[0] 1
@n2 = se_ref_plane {"action":"normal_to_edge","edge":"{{eG.items[?end=[100,0,20]].handle}}","at":"start","distance":30}
?= n2.rootPoint[0] 30
@n3 = se_ref_plane {"action":"normal_to_edge","edge":"{{eG.items[?end=[100,0,20]].handle}}","at":"end","distance":30}
?= n3.rootPoint[0] 70
@hG = se_hole {"plane":"{{tG.items[0].handle}}","centers":[50,30,20],"diameter":20}
@cG = se_geometry {"action":"faces","type":"cylinder"}
@t1 = se_ref_plane {"action":"tangent","plane":"2","face":"{{cG.items[0].handle}}"}
?= t1.rootPoint[0] 60
@t2 = se_ref_plane {"action":"tangent","plane":"2","face":"{{cG.items[0].handle}}","flip":true}
?= t2.rootPoint[0] 40
@tG2 = se_geometry {"action":"faces","direction":[0,0,1]}
! [invalid_argument] se_ref_plane {"action":"tangent","plane":"2","face":"{{tG2.items[0].handle}}"}
@cs = se_ref_plane {"action":"coordinate_system","origin":[10,20,30],"angles":[0,0,90]}
?= cs.origin[0] 10
?= cs.origin[1] 20
?= cs.origin[2] 30
?= cs.xAxis[1] 1
?= cs.zAxis[2] 1
@csl = se_ref_plane {"action":"coordinate_systems"}
?= csl.count 2
se_documents {"action":"close","document":"{{dG.handle}}","saveChanges":false}
# H: direct edits (se_part_feature). Plate 100x60x10 = 60000 with 2 holes D6.6 (-342.119 each), a R3 round on the top
#   front edge (-(1-pi/4)*9*100 = -193.142) and a D20 boss up to z=25 (+pi*100*15 = 4712.389) -> 63835.007. Deleting a hole
#   face fills it (+342.119), delete_holes up to D7 fills the other one, deleting the round face restores the edge (+193.142)
#   and deleting the boss side and top faces removes it (-4712.389) -> 60000. Offsetting the top face 5 out -> 90000 and the
#   x=100 face 20 in -> 80x60x15 = 72000
@dH = se_documents {"action":"new","kind":"part"}
@kH = se_sketch {"action":"create","plane":"1"}
se_sketch {"action":"rectangle","sketch":"{{kH.sketch}}","points":[0,0,100,60]}
se_sketch {"action":"close","sketch":"{{kH.sketch}}"}
se_extrude {"sketch":"{{kH.sketch}}","distance":10}
@tH = se_geometry {"action":"faces","direction":[0,0,1]}
se_hole {"plane":"{{tH.items[0].handle}}","centers":[10,10,10,90,10,10],"diameter":6.6}
@eH = se_geometry {"action":"edges","type":"line"}
se_round {"edges":["{{eH.items[?start=[0,0,10]].handle}}"],"radius":3}
@kH2 = se_sketch {"action":"create","plane":"1"}
se_sketch {"action":"circle","sketch":"{{kH2.sketch}}","center":[50,30],"radius":10}
se_sketch {"action":"close","sketch":"{{kH2.sketch}}"}
@bH = se_extrude {"sketch":"{{kH2.sketch}}","distance":25}
?= bH.volume 63835.007 0.05
@cH = se_geometry {"action":"faces","type":"cylinder"}
@df1 = se_part_feature {"action":"delete_faces","faces":["{{cH.items[?radius=3.3].handle}}"]}
?= df1.volumeChange 342.119 0.05
@dh = se_part_feature {"action":"delete_holes","diameter":7}
?= dh.volumeChange 342.119 0.05
! [feature_failed] se_part_feature {"action":"delete_holes","diameter":7}
@cH2 = se_geometry {"action":"faces","type":"cylinder"}
@dr = se_part_feature {"action":"delete_rounds","faces":["{{cH2.items[?radius=3].handle}}"]}
?= dr.volumeChange 193.142 0.05
@cH3 = se_geometry {"action":"faces","type":"cylinder"}
@tH3 = se_geometry {"action":"faces","direction":[0,0,1]}
@df2 = se_part_feature {"action":"delete_faces","faces":["{{cH3.items[?radius=10].handle}}","{{tH3.items[?area=314.159265].handle}}"]}
?= df2.volume 60000 0.05
@tH4 = se_geometry {"action":"faces","direction":[0,0,1]}
@of1 = se_part_feature {"action":"offset_faces","faces":["{{tH4.items[0].handle}}"],"distance":5}
?= of1.volume 90000 0.05
?= of1.direction outwards
@sH = se_geometry {"action":"faces","direction":[1,0,0]}
@of2 = se_part_feature {"action":"offset_faces","faces":["{{sH.items[0].handle}}"],"distance":-20}
?= of2.volume 72000 0.05
@gH = se_geometry {"action":"summary"}
?= gH.boundingBox.size[0] 80
?= gH.boundingBox.size[2] 15
! [invalid_argument] se_part_feature {"action":"delete_holes"}
! [invalid_argument] se_part_feature {"action":"offset_faces","faces":["{{sH.items[0].handle}}"],"distance":0}
! [invalid_argument] se_part_feature {"action":"delete_faces"}
se_documents {"action":"close","document":"{{dH.handle}}","saveChanges":false}
se_documents {"action":"list"}
