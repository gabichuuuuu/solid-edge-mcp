# A03: part features with hand-calculated volumes
# R: revolve of a 20x40 rectangle in XZ around its side x=0 -> cylinder r20 h40 = pi*400*40 = 50265.482
@dR = se_documents {"action":"new","kind":"part"}
@kR = se_sketch {"action":"create","plane":"3"}
@rR = se_sketch {"action":"rectangle","sketch":"{{kR.sketch}}","points":[0,0,20,40]}
@aR = se_sketch {"action":"axis","sketch":"{{kR.sketch}}","element":"{{rR.elements[3]}}"}
se_sketch {"action":"close","sketch":"{{kR.sketch}}"}
@vR = se_revolve {"sketch":"{{kR.sketch}}","axis":"{{aR.axis}}"}
?= vR.volume 50265.482 0.01
# r3 fillet on the upper circular edge: -2*pi*19.32990*1.931417 = -234.578 -> 50030.904
@cR = se_geometry {"action":"edges","type":"circle"}
@ro = se_round {"edges":["{{cR.items[?center=[0,0,40]].handle}}"],"radius":3}
?= ro.volume 50030.904 0.05
# chamfer 2 on the lower circular edge: -2*pi*19.33333*2 = -242.950 -> 49787.954
@cR2 = se_geometry {"action":"edges","type":"circle"}
@ch = se_chamfer {"edges":["{{cR2.items[?center=[0,0,0]].handle}}"],"distance":2}
?= ch.volume 49787.954 0.05
# partial revolve cut: rectangle x 5..25, z 15..25 rotated 90° around the Z axis -> -(pi*(20^2-5^2)/4)*10 = -2945.243
@kR3 = se_sketch {"action":"create","plane":"3"}
@rR3 = se_sketch {"action":"rectangle","sketch":"{{kR3.sketch}}","points":[5,15,25,25]}
@lR3 = se_sketch {"action":"line","sketch":"{{kR3.sketch}}","points":[0,0,0,40]}
@aR3 = se_sketch {"action":"axis","sketch":"{{kR3.sketch}}","element":"{{lR3.element}}"}
se_sketch {"action":"close","sketch":"{{kR3.sketch}}"}
@cut = se_revolve {"sketch":"{{kR3.sketch}}","axis":"{{aR3.axis}}","operation":"cut","angle":90}
?= cut.volumeChange -2945.243 0.05
se_documents {"action":"close","document":"{{dR.handle}}","saveChanges":false}
# S: shell with 2 mm walls, open at the top, on a 50x50x30 box -> 75000 - 46*46*28 = 15752
@dS = se_documents {"action":"new","kind":"part"}
@kS = se_sketch {"action":"create","plane":"1"}
se_sketch {"action":"rectangle","sketch":"{{kS.sketch}}","points":[0,0,50,50]}
se_sketch {"action":"close","sketch":"{{kS.sketch}}"}
se_extrude {"sketch":"{{kS.sketch}}","distance":30}
@tS = se_geometry {"action":"faces","direction":[0,0,1]}
@sh = se_shell {"thickness":2,"openFaces":["{{tS.items[0].handle}}"]}
?= sh.volume 15752 0.01
se_documents {"action":"close","document":"{{dS.handle}}","saveChanges":false}
# D: 5° draft of the four side faces of a 40x40x20 box from below -> frustum: 20/3*(1600+a^2+40a), a=40-40*tan5 = 36.500489 -> 29282.04
@dD = se_documents {"action":"new","kind":"part"}
@kD = se_sketch {"action":"create","plane":"1"}
se_sketch {"action":"rectangle","sketch":"{{kD.sketch}}","points":[0,0,40,40]}
se_sketch {"action":"close","sketch":"{{kD.sketch}}"}
se_extrude {"sketch":"{{kD.sketch}}","distance":20}
@f1 = se_geometry {"action":"faces","direction":[1,0,0]}
@f2 = se_geometry {"action":"faces","direction":[-1,0,0]}
@f3 = se_geometry {"action":"faces","direction":[0,1,0]}
@f4 = se_geometry {"action":"faces","direction":[0,-1,0]}
@dr = se_draft {"plane":"1","faces":["{{f1.items[0].handle}}","{{f2.items[0].handle}}","{{f3.items[0].handle}}","{{f4.items[0].handle}}"],"angle":5}
?= dr.volume 29282.0 0.5
se_documents {"action":"close","document":"{{dD.handle}}","saveChanges":false}
# P: plate 100x60x10; r5 hole at (10,10) by a through cut; pattern 3x2 every 30/40 -> 60000 - 6*785.398 = 55287.611
@dP = se_documents {"action":"new","kind":"part"}
@kP = se_sketch {"action":"create","plane":"1"}
se_sketch {"action":"rectangle","sketch":"{{kP.sketch}}","points":[0,0,100,60]}
se_sketch {"action":"close","sketch":"{{kP.sketch}}"}
se_extrude {"sketch":"{{kP.sketch}}","distance":10}
@kP2 = se_sketch {"action":"create","plane":"1"}
se_sketch {"action":"circle","sketch":"{{kP2.sketch}}","center":[10,10],"radius":5}
se_sketch {"action":"close","sketch":"{{kP2.sketch}}"}
@cP = se_extrude {"sketch":"{{kP2.sketch}}","operation":"cut","extent":"through_all"}
?= cP.volume 59214.602 0.01
@pr = se_pattern {"type":"rectangular","features":["{{cP.feature.handle}}"],"plane":"1","countX":3,"countY":2,"spacingX":30,"spacingY":40}
?= pr.volume 55287.611 0.01
# mirror of the original hole about the plane x=50 -> hole at (90,10): 54502.212
@mp = se_ref_plane {"action":"offset","plane":"2","distance":50}
@mi = se_pattern {"type":"mirror","features":["{{cP.feature.handle}}"],"plane":"{{mp.handle}}"}
?= mi.volume 54502.212 0.01
! [invalid_argument] se_pattern {"type":"rectangular","features":["{{cP.feature.handle}}"],"plane":"1","countX":2,"countY":1}
se_documents {"action":"close","document":"{{dP.handle}}","saveChanges":false}
# PC: pattern along a curve. Block 100x60x20 with an r5 hole at (50,20) = 118429.204; along the edge (0,0,0)->(100,0,0), 3 every 20 mm
#   towards the edge end -> holes at 50, 70, 90: 115287.611, centre of volume x = (6e6 - 1570.796*210)/115287.611 = 49.1825;
#   then reverse from the same hole -> two more at 30 and 10: 112146.018, x = 50 (symmetric)
@dPC = se_documents {"action":"new","kind":"part"}
@kPC = se_sketch {"action":"create","plane":"1","document":"{{dPC.handle}}"}
se_sketch {"action":"rectangle","sketch":"{{kPC.sketch}}","points":[0,0,100,60]}
se_sketch {"action":"close","sketch":"{{kPC.sketch}}"}
se_extrude {"sketch":"{{kPC.sketch}}","distance":20,"document":"{{dPC.handle}}"}
@kPC2 = se_sketch {"action":"create","plane":"1","document":"{{dPC.handle}}"}
se_sketch {"action":"circle","sketch":"{{kPC2.sketch}}","center":[50,20],"radius":5}
se_sketch {"action":"close","sketch":"{{kPC2.sketch}}"}
@cPC = se_extrude {"sketch":"{{kPC2.sketch}}","operation":"cut","extent":"through_all","document":"{{dPC.handle}}"}
?= cPC.volume 118429.204 0.01
@ePC = se_geometry {"action":"edges","direction":[1,0,0],"document":"{{dPC.handle}}"}
! [invalid_argument] se_pattern {"type":"curve","features":["{{cPC.feature.handle}}"],"curve":"{{ePC.items[?start=[0,0,0]].handle}}","count":3}
@pc1 = se_pattern {"type":"curve","features":["{{cPC.feature.handle}}"],"curve":"{{ePC.items[?start=[0,0,0]].handle}}","count":3,"spacing":20}
?= pc1.volume 115287.611 0.01
@pcp1 = se_physical {"document":"{{dPC.handle}}"}
?= pcp1.centerOfVolume[0] 49.1825 0.001
@ePC2 = se_geometry {"action":"edges","direction":[1,0,0],"document":"{{dPC.handle}}"}
@pc2 = se_pattern {"type":"curve","features":["{{cPC.feature.handle}}"],"curve":"{{ePC2.items[?start=[0,0,0]].handle}}","count":3,"spacing":20,"reverse":true}
?= pc2.volume 112146.018 0.01
@pcp2 = se_physical {"document":"{{dPC.handle}}"}
?= pcp2.centerOfVolume[0] 50 0.001
se_documents {"action":"close","document":"{{dPC.handle}}","saveChanges":false}
# C: disc r40 h10 with an r4 hole at (25,0) and a circular pattern of 6 -> 50265.482 - 6*502.655 = 47249.553
@dC = se_documents {"action":"new","kind":"part"}
@kC = se_sketch {"action":"create","plane":"1"}
se_sketch {"action":"circle","sketch":"{{kC.sketch}}","center":[0,0],"radius":40}
se_sketch {"action":"close","sketch":"{{kC.sketch}}"}
se_extrude {"sketch":"{{kC.sketch}}","distance":10}
@kC2 = se_sketch {"action":"create","plane":"1"}
se_sketch {"action":"circle","sketch":"{{kC2.sketch}}","center":[25,0],"radius":4}
se_sketch {"action":"close","sketch":"{{kC2.sketch}}"}
@cC = se_extrude {"sketch":"{{kC2.sketch}}","operation":"cut","extent":"through_all"}
@pc = se_pattern {"type":"circular","features":["{{cC.feature.handle}}"],"plane":"1","count":6}
?= pc.volume 47249.553 0.01
se_documents {"action":"close","document":"{{dC.handle}}","saveChanges":false}
# H: holes of all types in a 100x60x20 block
@dH = se_documents {"action":"new","kind":"part"}
@kH = se_sketch {"action":"create","plane":"1"}
se_sketch {"action":"rectangle","sketch":"{{kH.sketch}}","points":[0,0,100,60]}
se_sketch {"action":"close","sketch":"{{kH.sketch}}"}
@bH = se_extrude {"sketch":"{{kH.sketch}}","distance":20}
@tH = se_geometry {"action":"faces","direction":[0,0,1]}
# Ø6 countersink at 90° with a Ø12 through hole: -(pi*9*20 + cone from Ø12 to Ø6 over 3 mm: pi*3/3*(36+9+18) - pi*9*3) = -(565.487+197.920-84.823) = -678.584
@h1 = se_hole {"plane":"{{tH.items[0].handle}}","centers":[20,30,20],"type":"countersink","diameter":6,"countersinkDiameter":12}
?= h1.volumeChange -678.584 0.05
@tH2 = se_geometry {"action":"faces","direction":[0,0,1]}
# Ø6 counterbore with Ø11 x 6 deep: -(pi*9*14 + pi*30.25*6) = -(395.841+570.199) = -966.040
@h2 = se_hole {"plane":"{{tH2.items[0].handle}}","centers":[50,30,20],"type":"counterbore","diameter":6,"counterboreDiameter":11,"counterboreDepth":6}
?= h2.volumeChange -966.040 0.05
@tH3 = se_geometry {"action":"faces","direction":[0,0,1]}
# M6 thread (5 mm drill) finite 12 mm from the top: cylinder -pi*6.25*12 = -235.619 plus the conical drill tip if there is one
@h3 = se_hole {"plane":"{{tH3.items[0].handle}}","centers":[80,30,20],"type":"tapped","thread":"M6","extent":"finite","depth":12}
?= h3.volumeChange -235.619 0.01
@hd3 = se_com_get {"target":"{{h3.feature.handle}}","member":"HoleData"}
@tdm = se_com_get {"target":"{{hd3.value.handle}}","member":"ThreadDescription"}
?= tdm.value M6x1
@tH4 = se_geometry {"action":"faces","direction":[0,0,1]}
! se_hole {"plane":"{{tH4.items[0].handle}}","centers":[500,500,20],"diameter":5}
@ph = se_physical {}
@ftH = se_feature_tree {}
se_documents {"action":"close","document":"{{dH.handle}}","saveChanges":false}
# F: reference planes. Symmetric 100x100x40 block (z -20..20) = 400000; cylinder r10 h10 on the plane z=20 -> +3141.593, box z -20..30
@dF = se_documents {"action":"new","kind":"part"}
@kB = se_sketch {"action":"create","plane":"1"}
se_sketch {"action":"rectangle","sketch":"{{kB.sketch}}","points":[-50,-50,50,50]}
se_sketch {"action":"close","sketch":"{{kB.sketch}}"}
@eB = se_extrude {"sketch":"{{kB.sketch}}","distance":40,"direction":"symmetric"}
?= eB.volume 400000 0.01
@rp = se_ref_plane {"action":"offset","plane":"1","distance":20}
@ra = se_ref_plane {"action":"angle","plane":"1","pivot":"2","angle":30}
@rl = se_ref_plane {"action":"list"}
@kF = se_sketch {"action":"create","plane":"{{rp.handle}}"}
se_sketch {"action":"circle","sketch":"{{kF.sketch}}","center":[0,0],"radius":10}
se_sketch {"action":"close","sketch":"{{kF.sketch}}"}
@eF = se_extrude {"sketch":"{{kF.sketch}}","distance":10}
?= eF.volumeChange 3141.593 0.01
@gF = se_geometry {"action":"summary"}
?= gF.boundingBox.min[2] -20
?= gF.boundingBox.max[2] 30
# symmetric cut of 10 mm from the plane at 30°: whole r5 cylinder inside the block -> -785.398
@kF2 = se_sketch {"action":"create","plane":"{{ra.handle}}"}
se_sketch {"action":"circle","sketch":"{{kF2.sketch}}","center":[20,0],"radius":5}
se_sketch {"action":"close","sketch":"{{kF2.sketch}}"}
@eF2 = se_extrude {"sketch":"{{kF2.sketch}}","operation":"cut","distance":10,"direction":"symmetric"}
?= eF2.volumeChange -785.398 0.01
se_documents {"action":"close","document":"{{dF.handle}}","saveChanges":false}
# L: square 40 loft -> circle r15 at 50 mm (56453.84); sweep (7263.08); helix (3948.50)
@dL = se_documents {"action":"new","kind":"part"}
@a = se_sketch {"action":"create","plane":"1"}
se_sketch {"action":"rectangle","sketch":"{{a.sketch}}","points":[-20,-20,20,20]}
se_sketch {"action":"close","sketch":"{{a.sketch}}"}
@r = se_ref_plane {"action":"offset","plane":"1","distance":50}
@b = se_sketch {"action":"create","plane":"{{r.handle}}"}
se_sketch {"action":"circle","sketch":"{{b.sketch}}","center":[0,0],"radius":15}
se_sketch {"action":"close","sketch":"{{b.sketch}}"}
@lo = se_loft_sweep {"action":"loft","sketches":["{{a.sketch}}","{{b.sketch}}"]}
?= lo.volume 56453.84 0.05
se_documents {"action":"close","document":"{{dL.handle}}","saveChanges":false}
@dW = se_documents {"action":"new","kind":"part"}
@p = se_sketch {"action":"create","plane":"3"}
se_sketch {"action":"polyline","sketch":"{{p.sketch}}","points":[0,0,0,50,30,80],"closed":false}
se_sketch {"action":"close","sketch":"{{p.sketch}}","open":true}
@s = se_sketch {"action":"create","plane":"1"}
se_sketch {"action":"circle","sketch":"{{s.sketch}}","center":[0,0],"radius":5}
se_sketch {"action":"close","sketch":"{{s.sketch}}"}
@sw = se_loft_sweep {"action":"sweep","sketches":["{{s.sketch}}"],"path":"{{p.sketch}}"}
?= sw.volume 7263.08 0.05
se_documents {"action":"close","document":"{{dW.handle}}","saveChanges":false}
@dX = se_documents {"action":"new","kind":"part"}
@h = se_sketch {"action":"create","plane":"3"}
se_sketch {"action":"circle","sketch":"{{h.sketch}}","center":[10,3],"radius":2}
@hl = se_sketch {"action":"line","sketch":"{{h.sketch}}","points":[0,0,0,40]}
@ha = se_sketch {"action":"axis","sketch":"{{h.sketch}}","element":"{{hl.element}}"}
se_sketch {"action":"close","sketch":"{{h.sketch}}"}
@hx = se_loft_sweep {"action":"helix","sketches":["{{h.sketch}}"],"axis":"{{ha.axis}}","pitch":8,"turns":5}
?= hx.volume 3948.50 0.05
se_documents {"action":"close","document":"{{dX.handle}}","saveChanges":false}
# Other part features (se_part_feature). Rib: L section (80x10 + 10x50) extruded 60 symmetric = 78000; the line (10,40)-(50,10)
#   closes the triangle (10,10)-(10,40)-(50,10) of area 600 with the inner corner, 6 thick -> +3600. Its distance to the corner
#   is 24, so a 10 deep rib leaves out a similar triangle of height 14: 600*(1-(14/24)^2)*6 = +2375. A rib to one side of the
#   plane has the same volume
@dB = se_documents {"action":"new","kind":"part"}
@kB = se_sketch {"action":"create","plane":"3"}
se_sketch {"action":"polyline","sketch":"{{kB.sketch}}","points":[0,0,80,0,80,10,10,10,10,60,0,60],"closed":true}
se_sketch {"action":"close","sketch":"{{kB.sketch}}"}
@eB = se_extrude {"sketch":"{{kB.sketch}}","distance":60,"direction":"symmetric"}
?= eB.volume 78000 0.01
@kr = se_sketch {"action":"create","plane":"3"}
se_sketch {"action":"line","sketch":"{{kr.sketch}}","points":[10,40,50,10]}
se_sketch {"action":"close","sketch":"{{kr.sketch}}","open":true}
@rb = se_part_feature {"action":"rib","sketch":"{{kr.sketch}}","thickness":6}
?= rb.volumeChange 3600 0.01
se_feature_edit {"action":"delete","feature":"{{rb.feature.handle}}"}
@rb2 = se_part_feature {"action":"rib","sketch":"{{kr.sketch}}","thickness":6,"side":"normal"}
?= rb2.volumeChange 3600 0.01
se_feature_edit {"action":"delete","feature":"{{rb2.feature.handle}}"}
@rb3 = se_part_feature {"action":"rib","sketch":"{{kr.sketch}}","thickness":6,"depth":10}
?= rb3.volumeChange 2375 0.01
! [invalid_argument] se_part_feature {"action":"rib","thickness":6}
se_documents {"action":"close","document":"{{dB.handle}}","saveChanges":false}
# Thicken the top face of a 50x50x10 block by 5 -> +12500 = 37500 (inwards a solid gains nothing: 'reverse' fails, and the
#   failed attempt expires the face handles);
#   mirror the body about YZ (x = 0, a face of the block) -> 75000
@dT = se_documents {"action":"new","kind":"part"}
@kT = se_sketch {"action":"create","plane":"1"}
se_sketch {"action":"rectangle","sketch":"{{kT.sketch}}","points":[0,0,50,50]}
se_sketch {"action":"close","sketch":"{{kT.sketch}}"}
se_extrude {"sketch":"{{kT.sketch}}","distance":10}
@fT = se_geometry {"action":"faces","type":"plane","direction":[0,0,1]}
! [feature_failed] se_part_feature {"action":"thicken","faces":["{{fT.items[0].handle}}"],"thickness":5,"side":"reverse"}
@fT2 = se_geometry {"action":"faces","type":"plane","direction":[0,0,1]}
@th = se_part_feature {"action":"thicken","faces":["{{fT2.items[0].handle}}"],"thickness":5}
?= th.volumeChange 12500 0.01
?= th.direction normal
@mb = se_part_feature {"action":"mirror_body","plane":"2"}
?= mb.volume 75000 0.01
@sT = se_geometry {"action":"summary"}
?= sT.boundingBox.size[0] 100
se_documents {"action":"close","document":"{{dT.handle}}","saveChanges":false}
# G: more reference planes and coordinate systems. Block 100x60x20 with a hole Ø20 at (50,30). Plane through the corners
# (0,0,0), (100,0,20), (0,60,20): normal ±(-1200,-2000,6000)/6437.391 = ±(-0.18641,-0.31068,0.93205); mid plane z=10;
# planes normal to the edge y=0, z=20 at its end (x=100), 30 mm from either end (x=30, x=70) and at a quarter of its length from either end (x=25, x=75); tangent to the hole
# parallel to YZ at x=60 and x=40; a coordinate system at (10,20,30) turned 90° about Z.
@dG = se_documents {"action":"new","kind":"part"}
@kG = se_sketch {"action":"create","plane":"1"}
se_sketch {"action":"rectangle","sketch":"{{kG.sketch}}","points":[0,0,100,60]}
se_sketch {"action":"close","sketch":"{{kG.sketch}}"}
se_extrude {"sketch":"{{kG.sketch}}","distance":20}
@tG = se_geometry {"action":"faces","direction":[0,0,1]}
@bG = se_geometry {"action":"faces","direction":[0,0,-1]}
@p3 = se_ref_plane {"action":"three_points","points":[0,0,0,100,0,20,0,60,20]}
?= p3.normal[2] 0.93205 0.0001
?= p3.normal[0] -0.18641 0.0001
! [invalid_argument] se_ref_plane {"action":"three_points","points":[0,0,0,100,0,20,10,10,10]}
! [invalid_argument] se_ref_plane {"action":"three_points","points":[0,0,0,50,0,0,100,0,0]}
@mid = se_ref_plane {"action":"mid","plane":"{{bG.items[0].handle}}","plane2":"{{tG.items[0].handle}}"}
?= mid.rootPoint[2] 10
?= mid.normal[2] -1
! [invalid_argument] se_ref_plane {"action":"mid","plane":"1","plane2":"2"}
@eG = se_geometry {"action":"edges","limit":20}
@n1 = se_ref_plane {"action":"normal_to_edge","edge":"{{eG.items[?end=[100,0,20]].handle}}","at":"end"}
?= n1.rootPoint[0] 100
?= n1.normal[0] 1
@n2 = se_ref_plane {"action":"normal_to_edge","edge":"{{eG.items[?end=[100,0,20]].handle}}","at":"start","distance":30}
?= n2.rootPoint[0] 30
@n3 = se_ref_plane {"action":"normal_to_edge","edge":"{{eG.items[?end=[100,0,20]].handle}}","at":"end","distance":30}
?= n3.rootPoint[0] 70
@n4 = se_ref_plane {"action":"normal_to_edge","edge":"{{eG.items[?end=[100,0,20]].handle}}","at":"start","ratio":0.25}
?= n4.rootPoint[0] 25
?= n4.rootPoint[2] 20
@n5 = se_ref_plane {"action":"normal_to_edge","edge":"{{eG.items[?end=[100,0,20]].handle}}","at":"end","ratio":0.25}
?= n5.rootPoint[0] 75
! [invalid_argument] se_ref_plane {"action":"normal_to_edge","edge":"{{eG.items[?end=[100,0,20]].handle}}","ratio":1.5}
! [invalid_argument] se_ref_plane {"action":"normal_to_edge","edge":"{{eG.items[?end=[100,0,20]].handle}}","ratio":0.5,"distance":10}
@hG = se_hole {"plane":"{{tG.items[0].handle}}","centers":[50,30,20],"diameter":20}
@cG = se_geometry {"action":"faces","type":"cylinder"}
@t1 = se_ref_plane {"action":"tangent","plane":"2","face":"{{cG.items[0].handle}}"}
?= t1.rootPoint[0] 60
@t2 = se_ref_plane {"action":"tangent","plane":"2","face":"{{cG.items[0].handle}}","flip":true}
?= t2.rootPoint[0] 40
@tG2 = se_geometry {"action":"faces","direction":[0,0,1]}
! [invalid_argument] se_ref_plane {"action":"tangent","plane":"2","face":"{{tG2.items[0].handle}}"}
@cs = se_ref_plane {"action":"coordinate_system","origin":[10,20,30],"angles":[0,0,90]}
?= cs.origin[0] 10
?= cs.origin[1] 20
?= cs.origin[2] 30
?= cs.xAxis[1] 1
?= cs.zAxis[2] 1
# Coordinate system on two edges with the origin at their corner (100,0,20): X away from it along the top edge y=0 -> (-1,0,0),
#   Y along the edge x=100 -> (0,1,0), Z = X x Y -> (0,0,-1). An origin off the edges and parallel edges fail; 3 systems
@ex = se_geometry {"action":"edges","direction":[1,0,0]}
@ey = se_geometry {"action":"edges","direction":[0,1,0]}
@ce = se_ref_plane {"action":"coordinate_system","edges":["{{ex.items[?end=[100,0,20]].handle}}","{{ey.items[?start=[100,0,20]].handle}}"],"origin":[100,0,20]}
?= ce.origin[0] 100
?= ce.origin[2] 20
?= ce.xAxis[0] -1
?= ce.yAxis[1] 1
?= ce.zAxis[2] -1
! [invalid_argument] se_ref_plane {"action":"coordinate_system","edges":["{{ex.items[?end=[100,0,20]].handle}}","{{ey.items[?start=[100,0,20]].handle}}"],"origin":[50,0,20]}
! [invalid_argument] se_ref_plane {"action":"coordinate_system","edges":["{{ex.items[?end=[100,0,20]].handle}}","{{ex.items[?end=[100,0,0]].handle}}"],"origin":[100,0,20]}
@csl = se_ref_plane {"action":"coordinate_systems"}
?= csl.count 3
se_documents {"action":"close","document":"{{dG.handle}}","saveChanges":false}
# H: direct edits (se_part_feature). Plate 100x60x10 = 60000 with 2 holes D6.6 (-342.119 each), a R3 round on the top
#   front edge (-(1-pi/4)*9*100 = -193.142) and a D20 boss up to z=25 (+pi*100*15 = 4712.389) -> 63835.007. Deleting a hole
#   face fills it (+342.119), delete_holes up to D7 fills the other one, deleting the round face restores the edge (+193.142)
#   and deleting the boss side and top faces removes it (-4712.389) -> 60000. Offsetting the top face 5 out -> 90000 and the
#   x=100 face 20 in -> 80x60x15 = 72000
@dH = se_documents {"action":"new","kind":"part"}
@kH = se_sketch {"action":"create","plane":"1"}
se_sketch {"action":"rectangle","sketch":"{{kH.sketch}}","points":[0,0,100,60]}
se_sketch {"action":"close","sketch":"{{kH.sketch}}"}
se_extrude {"sketch":"{{kH.sketch}}","distance":10}
@tH = se_geometry {"action":"faces","direction":[0,0,1]}
se_hole {"plane":"{{tH.items[0].handle}}","centers":[10,10,10,90,10,10],"diameter":6.6}
@eH = se_geometry {"action":"edges","type":"line"}
se_round {"edges":["{{eH.items[?start=[0,0,10]].handle}}"],"radius":3}
@kH2 = se_sketch {"action":"create","plane":"1"}
se_sketch {"action":"circle","sketch":"{{kH2.sketch}}","center":[50,30],"radius":10}
se_sketch {"action":"close","sketch":"{{kH2.sketch}}"}
@bH = se_extrude {"sketch":"{{kH2.sketch}}","distance":25}
?= bH.volume 63835.007 0.05
@cH = se_geometry {"action":"faces","type":"cylinder"}
@df1 = se_part_feature {"action":"delete_faces","faces":["{{cH.items[?radius=3.3].handle}}"]}
?= df1.volumeChange 342.119 0.05
@dh = se_part_feature {"action":"delete_holes","diameter":7}
?= dh.volumeChange 342.119 0.05
! [feature_failed] se_part_feature {"action":"delete_holes","diameter":7}
@cH2 = se_geometry {"action":"faces","type":"cylinder"}
@dr = se_part_feature {"action":"delete_rounds","faces":["{{cH2.items[?radius=3].handle}}"]}
?= dr.volumeChange 193.142 0.05
@cH3 = se_geometry {"action":"faces","type":"cylinder"}
@tH3 = se_geometry {"action":"faces","direction":[0,0,1]}
@df2 = se_part_feature {"action":"delete_faces","faces":["{{cH3.items[?radius=10].handle}}","{{tH3.items[?area=314.159265].handle}}"]}
?= df2.volume 60000 0.05
@tH4 = se_geometry {"action":"faces","direction":[0,0,1]}
@of1 = se_part_feature {"action":"offset_faces","faces":["{{tH4.items[0].handle}}"],"distance":5}
?= of1.volume 90000 0.05
?= of1.direction outwards
@sH = se_geometry {"action":"faces","direction":[1,0,0]}
@of2 = se_part_feature {"action":"offset_faces","faces":["{{sH.items[0].handle}}"],"distance":-20}
?= of2.volume 72000 0.05
@gH = se_geometry {"action":"summary"}
?= gH.boundingBox.size[0] 80
?= gH.boundingBox.size[2] 15
! [invalid_argument] se_part_feature {"action":"delete_holes"}
! [invalid_argument] se_part_feature {"action":"offset_faces","faces":["{{sH.items[0].handle}}"],"distance":0}
! [invalid_argument] se_part_feature {"action":"delete_faces"}
# replace_faces on that 80x60x15 block: top face onto a plane at z=25 -> 80*60*25 = 120000; again onto the same plane changes
#   nothing (feature_failed, deleted); the +y face onto an offset surface 10 out of it -> y 70: 80*70*25 = 140000
@rpH = se_ref_plane {"action":"offset","plane":"1","distance":25}
@tH5 = se_geometry {"action":"faces","direction":[0,0,1]}
@rf1 = se_part_feature {"action":"replace_faces","faces":["{{tH5.items[0].handle}}"],"replaceWith":"{{rpH.handle}}"}
?= rf1.volume 120000 0.05
@tH6 = se_geometry {"action":"faces","direction":[0,0,1]}
! [feature_failed] se_part_feature {"action":"replace_faces","faces":["{{tH6.items[0].handle}}"],"replaceWith":"{{rpH.handle}}"}
@yH = se_geometry {"action":"faces","direction":[0,1,0]}
@sfH = se_surface {"action":"offset","faces":["{{yH.items[0].handle}}"],"distance":10}
@yH2 = se_geometry {"action":"faces","direction":[0,1,0]}
@rf2 = se_part_feature {"action":"replace_faces","faces":["{{yH2.items[0].handle}}"],"replaceWith":"{{sfH.surface.handle}}"}
?= rf2.volume 140000 0.05
@gH2 = se_geometry {"action":"summary"}
?= gH2.boundingBox.max[1] 70 0.001
! [invalid_argument] se_part_feature {"action":"replace_faces","faces":["{{yH2.items[0].handle}}"]}
se_documents {"action":"close","document":"{{dH.handle}}","saveChanges":false}
# I: slots, web network and body scale. Block 100x60x20; sketches on a plane at z=20 (model x/y).
#   Slot through along (20,30)-(80,30), width 10, rounded ends: (60*10 + pi*5^2)*20 = 13570.796. Square slot along (20,50)-(80,50),
#   width 6, depth 5: 60*6*5 = 1800. Scale z by 0.5: (120000 - 13570.796 - 1800)/2 = 52314.602, height 10.
#   Lip 1 wide and 2 high on the 4 outer edges of the rim of a shell 2 mm open at the top (23232): 1*2*(320 - 4) = 632.
#   Web network in that shell: line x=50 across, thickness 2 -> 2*18*56 = 2016; line x=25 with depth 10 -> 2*10*56 = 1120
@dI = se_documents {"action":"new","kind":"part"}
@kI = se_sketch {"action":"create","plane":"1"}
se_sketch {"action":"rectangle","sketch":"{{kI.sketch}}","points":[0,0,100,60]}
se_sketch {"action":"close","sketch":"{{kI.sketch}}"}
se_extrude {"sketch":"{{kI.sketch}}","distance":20}
@pI = se_ref_plane {"action":"offset","plane":"1","distance":20}
@kI1 = se_sketch {"action":"create","plane":"{{pI.handle}}"}
se_sketch {"action":"line","sketch":"{{kI1.sketch}}","points":[20,30,80,30]}
se_sketch {"action":"close","sketch":"{{kI1.sketch}}","open":true}
@sl1 = se_part_feature {"action":"slot","sketch":"{{kI1.sketch}}","width":10}
?= sl1.volumeChange -13570.796 0.05
?= sl1.feature.type Slot
@kI2 = se_sketch {"action":"create","plane":"{{pI.handle}}"}
se_sketch {"action":"line","sketch":"{{kI2.sketch}}","points":[20,50,80,50]}
se_sketch {"action":"close","sketch":"{{kI2.sketch}}","open":true}
@sl2 = se_part_feature {"action":"slot","sketch":"{{kI2.sketch}}","width":6,"depth":5,"squareEnds":true}
?= sl2.volumeChange -1800 0.05
@sc = se_part_feature {"action":"scale_body","scale":[1,1,0.5]}
?= sc.volume 52314.602 0.05
@gI = se_geometry {"action":"summary"}
?= gI.boundingBox.size[2] 10
! [invalid_argument] se_part_feature {"action":"scale_body","scale":[1]}
! [invalid_argument] se_part_feature {"action":"scale_body","scale":[1,2]}
! [invalid_argument] se_part_feature {"action":"slot","sketch":"{{kI2.sketch}}"}
se_documents {"action":"close","document":"{{dI.handle}}","saveChanges":false}
# Counterbored slots. Block 100x60x20, sketches at z=20. Square ends along (20,20)-(80,20), width 10, counterbore 18 wide and 5 deep:
#   60*10*20 + 60*(18-10)*5 = 14400. Rounded along (20,45)-(80,45), width 10, counterbore 16 x 5:
#   (600 + 25pi)*20 + (60*16 + 64pi - 600 - 25pi)*5 = 15983.407.
@dI2 = se_documents {"action":"new","kind":"part"}
@kI3 = se_sketch {"action":"create","plane":"1"}
se_sketch {"action":"rectangle","sketch":"{{kI3.sketch}}","points":[0,0,100,60]}
se_sketch {"action":"close","sketch":"{{kI3.sketch}}"}
se_extrude {"sketch":"{{kI3.sketch}}","distance":20}
@pI2 = se_ref_plane {"action":"offset","plane":"1","distance":20}
@kI4 = se_sketch {"action":"create","plane":"{{pI2.handle}}"}
se_sketch {"action":"line","sketch":"{{kI4.sketch}}","points":[20,20,80,20]}
se_sketch {"action":"close","sketch":"{{kI4.sketch}}","open":true}
! [invalid_argument] se_part_feature {"action":"slot","sketch":"{{kI4.sketch}}","width":10,"counterbore":[8,5]}
! [invalid_argument] se_part_feature {"action":"slot","sketch":"{{kI4.sketch}}","width":10,"depth":4,"counterbore":[18,5]}
! [invalid_argument] se_part_feature {"action":"slot","sketch":"{{kI4.sketch}}","width":10,"counterbore":[18]}
@sl3 = se_part_feature {"action":"slot","sketch":"{{kI4.sketch}}","width":10,"squareEnds":true,"counterbore":[18,5]}
?= sl3.volumeChange -14400 0.05
@kI5 = se_sketch {"action":"create","plane":"{{pI2.handle}}"}
se_sketch {"action":"line","sketch":"{{kI5.sketch}}","points":[20,45,80,45]}
se_sketch {"action":"close","sketch":"{{kI5.sketch}}","open":true}
@sl4 = se_part_feature {"action":"slot","sketch":"{{kI5.sketch}}","width":10,"counterbore":[16,5]}
?= sl4.volumeChange -15983.407 0.05
se_documents {"action":"close","document":"{{dI2.handle}}","saveChanges":false}
@dW = se_documents {"action":"new","kind":"part"}
@kW = se_sketch {"action":"create","plane":"1"}
se_sketch {"action":"rectangle","sketch":"{{kW.sketch}}","points":[0,0,100,60]}
se_sketch {"action":"close","sketch":"{{kW.sketch}}"}
se_extrude {"sketch":"{{kW.sketch}}","distance":20}
@tW = se_geometry {"action":"faces","direction":[0,0,1]}
@shW = se_shell {"thickness":2,"openFaces":["{{tW.items[0].handle}}"]}
?= shW.volume 23232 0.05
@rW = se_geometry {"action":"faces","direction":[0,0,1]}
@eW = se_geometry {"action":"edges","source":"{{rW.items[?area=624].handle}}"}
@lW = se_part_feature {"action":"lip","edges":["{{eW.items[?start=[0,0,20]].handle}}","{{eW.items[?start=[100,0,20]].handle}}","{{eW.items[?start=[100,60,20]].handle}}","{{eW.items[?start=[0,60,20]].handle}}"],"width":1,"height":2}
?= lW.volumeChange 632 0.05
! [invalid_argument] se_part_feature {"action":"lip","edges":["{{eW.items[0].handle}}"],"width":1}
@pW = se_ref_plane {"action":"offset","plane":"1","distance":20}
@kW1 = se_sketch {"action":"create","plane":"{{pW.handle}}"}
se_sketch {"action":"line","sketch":"{{kW1.sketch}}","points":[50,0,50,60]}
se_sketch {"action":"close","sketch":"{{kW1.sketch}}","open":true}
@wn1 = se_part_feature {"action":"web_network","sketch":"{{kW1.sketch}}","thickness":2}
?= wn1.volumeChange 2016 0.05
@kW2 = se_sketch {"action":"create","plane":"{{pW.handle}}"}
se_sketch {"action":"line","sketch":"{{kW2.sketch}}","points":[25,0,25,60]}
se_sketch {"action":"close","sketch":"{{kW2.sketch}}","open":true}
@wn2 = se_part_feature {"action":"web_network","sketch":"{{kW2.sketch}}","thickness":2,"depth":10}
?= wn2.volumeChange 1120 0.05
se_documents {"action":"close","document":"{{dW.handle}}","saveChanges":false}
# J: copied part. Block 100x60x20 saved and closed; copied into an empty part = its base body (120000, centre (50,30,10)); the
#   same copy again lies inside the body, adds nothing and is deleted; mirrored about plane 2 (x = 0) it touches the block and is
#   united -> 240000, centre x 0. Scaled 0.5 into another empty part -> 15000. A missing file and a .asm fail
@dJ = se_documents {"action":"new","kind":"part"}
@kJ = se_sketch {"action":"create","plane":"1"}
se_sketch {"action":"rectangle","sketch":"{{kJ.sketch}}","points":[0,0,100,60]}
se_sketch {"action":"close","sketch":"{{kJ.sketch}}"}
se_extrude {"sketch":"{{kJ.sketch}}","distance":20}
se_documents {"action":"save_as","path":"{{work}}\\a03_copy_src.par","overwrite":true}
se_documents {"action":"close","document":"{{dJ.handle}}","saveChanges":false}
@cJ1 = se_documents {"action":"new","kind":"part"}
@cp1 = se_part_feature {"action":"copy_part","path":"{{work}}\\a03_copy_src.par"}
?= cp1.volume 120000 0.01
?~ cp1.feature.type CopiedPart
! [feature_failed] se_part_feature {"action":"copy_part","path":"{{work}}\\a03_copy_src.par"}
@cp2 = se_part_feature {"action":"copy_part","path":"{{work}}\\a03_copy_src.par","plane":"2"}
?= cp2.volume 240000 0.01
@pJ = se_physical {}
?= pJ.centerOfVolume[0] 0 0.001
! [not_found] se_part_feature {"action":"copy_part","path":"{{work}}\\no_such_part.par"}
! [invalid_argument] se_part_feature {"action":"copy_part","path":"{{work}}\\a03_copy_src.asm"}
se_documents {"action":"close","document":"{{cJ1.handle}}","saveChanges":false}
@cJ2 = se_documents {"action":"new","kind":"part"}
@cp3 = se_part_feature {"action":"copy_part","path":"{{work}}\\a03_copy_src.par","scale":[0.5]}
?= cp3.volume 15000 0.01
se_documents {"action":"close","document":"{{cJ2.handle}}","saveChanges":false}
# K: tangent planes at a point and at an angle. Cylinder r10 h30 on plane 1: tangent at the start of its top edge (10,0,30)
#   with the normal out of the face (+x), or into it with flip. At 30° about the axis from plane 3 (normal -y) the point is
#   30° from -x towards -y, (-8.660,-5,15), outward normal (-0.866,-0.5,0); at -30° on the other side; at 120° from plane 2
#   (normal +x) the outward normal makes sin 120° with +x: (0.866,0.5,0). Hemisphere r20: tangent at (20,0,0), normal +x.
@dK = se_documents {"action":"new","kind":"part"}
@cK = se_primitive {"shape":"cylinder","plane":"1","center":[0,0,0],"radius":10,"depth":30}
@fK = se_geometry {"action":"faces","type":"cylinder"}
@tk1 = se_ref_plane {"action":"tangent","face":"{{fK.items[0].handle}}","points":[10,0,30]}
?= tk1.normal[0] 1
?= tk1.rootPoint[0] 10
@tk2 = se_ref_plane {"action":"tangent","face":"{{fK.items[0].handle}}","points":[10,0,30],"plane":"1","flip":true}
?= tk2.normal[0] -1
! [invalid_argument] se_ref_plane {"action":"tangent","face":"{{fK.items[0].handle}}","points":[10,0,30],"plane":"2"}
! [invalid_argument] se_ref_plane {"action":"tangent","face":"{{fK.items[0].handle}}","points":[5,5,5]}
! [invalid_argument] se_ref_plane {"action":"tangent","face":"{{fK.items[0].handle}}","points":[10,0,30],"angle":30}
@ta1 = se_ref_plane {"action":"tangent","face":"{{fK.items[0].handle}}","plane":"3","angle":30}
?= ta1.normal[0] -0.866025404
?= ta1.normal[1] -0.5
?= ta1.rootPoint[1] -5
@ta2 = se_ref_plane {"action":"tangent","face":"{{fK.items[0].handle}}","plane":"3","angle":-30}
?= ta2.normal[1] 0.5
?= ta2.rootPoint[1] 5
@ta3 = se_ref_plane {"action":"tangent","face":"{{fK.items[0].handle}}","plane":"2","angle":120}
?= ta3.normal[0] 0.866025404
?= ta3.normal[1] 0.5
! [invalid_argument] se_ref_plane {"action":"tangent","face":"{{fK.items[0].handle}}","plane":"1","angle":30}
! [invalid_argument] se_ref_plane {"action":"tangent","face":"{{fK.items[0].handle}}"}
@pK = se_geometry {"action":"faces","direction":[0,0,1]}
! [invalid_argument] se_ref_plane {"action":"tangent","face":"{{pK.items[0].handle}}","points":[10,0,30]}
se_documents {"action":"close","document":"{{dK.handle}}","saveChanges":false}
@dK2 = se_documents {"action":"new","kind":"part"}
se_primitive {"shape":"sphere","plane":"1","center":[0,0,0],"radius":20}
se_primitive {"shape":"box","operation":"cut","plane":"1","center":[0,0,0],"size":[50,50],"depth":25}
@sK = se_geometry {"action":"faces","type":"sphere"}
@tk3 = se_ref_plane {"action":"tangent","face":"{{sK.items[0].handle}}","points":[20,0,0]}
?= tk3.normal[0] 1
?= tk3.rootPoint[0] 20
se_documents {"action":"close","document":"{{dK2.handle}}","saveChanges":false}
# Bodies: box 100x60x20 split by a plane at x = 30 -> two design bodies of 84000 (x 30..100, first model) and 36000 mm3; summary,
#   physical properties and faces cover both (total 120000, 7850 kg/m3 -> 0.942 kg, centre (50, 30, 10), Ixx about the origin
#   = m (60^2 + 20^2) / 3 = 1256 kg mm2); unite joins them again.
@dB = se_documents {"action":"new","kind":"part"}
@kB = se_sketch {"action":"create","plane":"1","document":"{{dB.handle}}"}
se_sketch {"action":"rectangle","sketch":"{{kB.sketch}}","points":[0,0,100,60]}
se_sketch {"action":"close","sketch":"{{kB.sketch}}"}
se_extrude {"sketch":"{{kB.sketch}}","distance":20,"document":"{{dB.handle}}"}
@pB = se_ref_plane {"action":"offset","plane":"2","distance":30,"document":"{{dB.handle}}"}
! [invalid_argument] se_part_feature {"action":"split","document":"{{dB.handle}}"}
! [invalid_argument] se_part_feature {"action":"unite","document":"{{dB.handle}}"}
@sB = se_part_feature {"action":"split","plane":"{{pB.handle}}","document":"{{dB.handle}}"}
?= sB.volume 120000 0.01
?= sB.bodies[0].volume 84000 0.01
?= sB.bodies[1].volume 36000 0.01
?= sB.bodies[1].boundingBox.max[0] 30 0.001
@gB = se_geometry {"action":"summary","document":"{{dB.handle}}"}
?= gB.volume 120000 0.01
?= gB.faces 12
?= gB.boundingBox.size[0] 100 0.001
@phB = se_physical {"density":7850,"document":"{{dB.handle}}"}
?= phB.volume 120000 0.01
?= phB.mass 0.942 1e-6
?= phB.centerOfVolume[0] 50 0.001
?= phB.inertiaAboutOrigin.ixx 1256 0.01
?= phB.bodies[1].volume 36000 0.01
@tB = se_geometry {"action":"faces","direction":[0,0,1],"document":"{{dB.handle}}"}
?= tB.count 2
@fB = se_geometry {"action":"faces","source":"{{sB.bodies[1].handle}}","direction":[0,0,1],"document":"{{dB.handle}}"}
?= fB.items[0].area 1800 0.01
@uB = se_part_feature {"action":"unite","document":"{{dB.handle}}"}
?= uB.volume 120000 0.01
?= uB.bodies[0].volume 120000 0.01
@gB2 = se_geometry {"action":"summary","document":"{{dB.handle}}"}
?= gB2.faces 6
@phU = se_physical {"density":7850,"document":"{{dB.handle}}"}
?= phU.volume 120000 0.01
?= phU.mass 0.942 1e-6
! [invalid_argument] se_part_feature {"action":"unite","document":"{{dB.handle}}"}
se_documents {"action":"close","document":"{{dB.handle}}","saveChanges":false}
# The same split, united with the second body listed first: the body of the first model still receives the other one, so the
#   part stays measurable (120000, 6 faces). Then a split part scaled by 0.5: only the first body is scaled, 84000 / 8 + 36000.
@dC = se_documents {"action":"new","kind":"part"}
@kC = se_sketch {"action":"create","plane":"1","document":"{{dC.handle}}"}
se_sketch {"action":"rectangle","sketch":"{{kC.sketch}}","points":[0,0,100,60]}
se_sketch {"action":"close","sketch":"{{kC.sketch}}"}
se_extrude {"sketch":"{{kC.sketch}}","distance":20,"document":"{{dC.handle}}"}
@pC = se_ref_plane {"action":"offset","plane":"2","distance":30,"document":"{{dC.handle}}"}
@sC = se_part_feature {"action":"split","plane":"{{pC.handle}}","document":"{{dC.handle}}"}
@uC = se_part_feature {"action":"unite","bodies":["{{sC.bodies[1].handle}}","{{sC.bodies[0].handle}}"],"document":"{{dC.handle}}"}
?= uC.volume 120000 0.01
@gC = se_geometry {"action":"summary","document":"{{dC.handle}}"}
?= gC.volume 120000 0.01
?= gC.faces 6
se_documents {"action":"close","document":"{{dC.handle}}","saveChanges":false}
@dD = se_documents {"action":"new","kind":"part"}
@kD = se_sketch {"action":"create","plane":"1","document":"{{dD.handle}}"}
se_sketch {"action":"rectangle","sketch":"{{kD.sketch}}","points":[0,0,100,60]}
se_sketch {"action":"close","sketch":"{{kD.sketch}}"}
se_extrude {"sketch":"{{kD.sketch}}","distance":20,"document":"{{dD.handle}}"}
@pD = se_ref_plane {"action":"offset","plane":"2","distance":30,"document":"{{dD.handle}}"}
se_part_feature {"action":"split","plane":"{{pD.handle}}","document":"{{dD.handle}}"}
@xD = se_part_feature {"action":"scale_body","scale":[0.5],"document":"{{dD.handle}}"}
?= xD.volume 46500 0.01
se_documents {"action":"close","document":"{{dD.handle}}","saveChanges":false}
se_documents {"action":"list"}
