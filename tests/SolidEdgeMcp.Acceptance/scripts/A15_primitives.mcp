# A15: primitives (se_primitive). Solid Edge builds them only in synchronous modelling; the document goes back to ordered.
# Box 100x60x20 on the XY plane centred at (50,30,0): 120000, box (0,0,0)-(100,60,20).
#   + cylinder r10 x 30 on the top face at (50,30,20): pi*100*30 = 9424.778 -> 129424.778, top at z=50
#   - cylinder r5 x 10 cut from the top face at (20,30,20), auto side = into the part: pi*25*10 = 785.398 -> 128639.380
#   - box 10x10 x 5 cut on the XY plane at (80,30,0): auto tries against the normal (outside, no change), then along it: 500 -> 128139.380
#   + sphere r10 on the YZ plane at (0,30,10): the half outside the part, 2/3*pi*1000 = 2094.395 -> 130233.775, min x = -10
#   - sphere r5 cut on the XY plane at (80,50,0): the half inside, 2/3*pi*125 = 261.799 -> 129971.976
#   + box 20x10 x 10 symmetric on the XZ plane at (50,0,10) (width along x, height along z): the half at y<0, 20*10*5 = 1000 -> 130971.976, min y = -5
@p = se_documents {"action":"new","kind":"part"}
@b = se_primitive {"shape":"box","center":[50,30,0],"size":[100,60],"depth":20}
?= b.volume 120000 0.001
?~ b.feature.type BoxFeature
?~ b.modelingMode ordered
@s1 = se_geometry {"action":"summary"}
?= s1.boundingBox.min[2] 0 0.0001
?= s1.boundingBox.max[0] 100 0.0001
?= s1.boundingBox.max[1] 60 0.0001
?= s1.boundingBox.max[2] 20 0.0001
@t1 = se_geometry {"action":"faces","direction":[0,0,1]}
@c = se_primitive {"shape":"cylinder","plane":"{{t1.items[0].handle}}","center":[50,30,20],"radius":10,"depth":30}
?= c.volumeChange 9424.778 0.001
@s2 = se_geometry {"action":"summary"}
?= s2.boundingBox.max[2] 50 0.0001
@t2 = se_geometry {"action":"faces","direction":[0,0,1],"type":"plane"}
@k = se_primitive {"shape":"cylinder","operation":"cut","plane":"{{t2.items[?area=5685.840735].handle}}","center":[20,30,20],"radius":5,"depth":10}
?= k.volumeChange -785.398 0.001
@kb = se_primitive {"shape":"box","operation":"cut","plane":"1","center":[80,30,0],"size":[10,10],"depth":5}
?= kb.volumeChange -500 0.001
?= kb.volume 128139.380 0.001
@sp = se_primitive {"shape":"sphere","plane":"2","center":[0,30,10],"radius":10}
?= sp.volumeChange 2094.395 0.001
@s3 = se_geometry {"action":"summary"}
?= s3.boundingBox.min[0] -10 0.0001
@ks = se_primitive {"shape":"sphere","operation":"cut","plane":"1","center":[80,50,0],"radius":5}
?= ks.volumeChange -261.799 0.001
@sy = se_primitive {"shape":"box","plane":"3","center":[50,0,10],"size":[20,10],"depth":10,"side":"symmetric"}
?= sy.volumeChange 1000 0.001
?= sy.volume 130971.976 0.001
@s4 = se_geometry {"action":"summary"}
?= s4.boundingBox.min[1] -5 0.0001
# Errors: centre off the plane; box without size; a cut that touches nothing (both sides tried, undone); the volume and mode stay
! [invalid_argument] se_primitive {"shape":"box","center":[50,30,5],"size":[10,10],"depth":5}
! [invalid_argument] se_primitive {"shape":"box","center":[50,30,0],"depth":5}
! [feature_failed] se_primitive {"shape":"cylinder","operation":"cut","center":[500,500,0],"radius":5,"depth":5}
@s5 = se_geometry {"action":"summary"}
?= s5.volume 130971.976 0.001
?~ s5.modelingMode ordered
se_documents {"action":"close","document":"{{p.handle}}","saveChanges":false}
# Ordered part (extrude 100x60x20) plus a box 20x20 x 10 on its top face at (50,30,20): +4000 -> 124000; the extrude stays
@q = se_documents {"action":"new","kind":"part"}
@sk = se_sketch {"action":"create","plane":"1"}
se_sketch {"action":"rectangle","sketch":"{{sk.sketch}}","points":[0,0,100,60]}
se_sketch {"action":"close","sketch":"{{sk.sketch}}"}
se_extrude {"sketch":"{{sk.sketch}}","distance":20}
@tq = se_geometry {"action":"faces","direction":[0,0,1]}
@bq = se_primitive {"shape":"box","plane":"{{tq.items[0].handle}}","center":[50,30,20],"size":[20,20],"depth":10}
?= bq.volume 124000 0.001
@ft = se_feature_tree {}
?~ ft.modelingMode ordered
?~ ft.features[?name="ExtrudedProtrusion_1"].status ok
se_documents {"action":"close","document":"{{q.handle}}","saveChanges":false}
# Rotated boxes. 40x20 x 10 at (0,0,0) turned 30 degrees: Solid Edge turns about the first corner, the tool keeps the centre ->
#   centre of volume (0,0,5); top face box 22.32 x 18.66 (20cos30 + 10sin30, 20sin30 + 10cos30). A cut 10x4 x 5 turned -45 on the
#   top face at its centre removes 200. On plane 2 (x axis = y, y axis = z): 60 degrees puts the 40 edges along (0, 0.5, 0.866),
#   centre (0,10,5) + 5 along x. A cylinder with an angle fails
@r = se_documents {"action":"new","kind":"part"}
@rb = se_primitive {"shape":"box","center":[0,0,0],"size":[40,20],"depth":10,"angle":30}
@rp = se_physical {}
?= rp.centerOfVolume[0] 0 0.001
?= rp.centerOfVolume[1] 0 0.001
@rt = se_geometry {"action":"faces","direction":[0,0,1]}
?= rt.items[0].boundingBox.max[0] 22.320508 0.001
?= rt.items[0].boundingBox.max[1] 18.660254 0.001
@rc = se_primitive {"shape":"box","operation":"cut","plane":"{{rt.items[0].handle}}","center":[0,0,10],"size":[10,4],"depth":5,"angle":-45}
?= rc.volumeChange -200 0.01
! [invalid_argument] se_primitive {"shape":"cylinder","center":[0,0,0],"radius":5,"depth":5,"angle":10}
se_documents {"action":"close","document":"{{r.handle}}","saveChanges":false}
@r2 = se_documents {"action":"new","kind":"part"}
se_primitive {"shape":"box","plane":"2","center":[0,10,5],"size":[40,20],"depth":10,"angle":60}
@rq = se_physical {}
?= rq.centerOfVolume[0] 5 0.001
?= rq.centerOfVolume[1] 10 0.001
?= rq.centerOfVolume[2] 5 0.001
@re = se_geometry {"action":"edges","direction":[0,0.5,0.866025404]}
?= re.count 4
se_documents {"action":"close","document":"{{r2.handle}}","saveChanges":false}
# Boxes by corners. Opposite corners (0,0,0) and (40,20,0), depth 10 -> 8000, box (0,0,0)-(40,20,10). Three points: edge (0,0,0) to
#   (30,40,0) (length 50) and (-8,6,0) on the opposite edge, 10 away -> 50 x 10 x 10 = 5000 more, corners (0,0) (30,40) (22,46)
#   (-8,6), in another part: box from x -8 to 30 and y 0 to 46.
@k = se_documents {"action":"new","kind":"part"}
@kb = se_primitive {"shape":"box","corners":[0,0,0,40,20,0],"depth":10}
?= kb.volume 8000 0.001
@ks = se_geometry {"action":"summary"}
?= ks.boundingBox.max[0] 40 0.0001
?= ks.boundingBox.max[1] 20 0.0001
se_documents {"action":"close","document":"{{k.handle}}","saveChanges":false}
@k = se_documents {"action":"new","kind":"part"}
@k3 = se_primitive {"shape":"box","corners":[0,0,0,30,40,0,-8,6,0],"depth":10}
?= k3.volume 5000 0.01
@ks2 = se_geometry {"action":"summary"}
?= ks2.boundingBox.min[0] -8 0.0001
?= ks2.boundingBox.max[0] 30 0.0001
?= ks2.boundingBox.max[1] 46 0.0001
! [invalid_argument] se_primitive {"shape":"box","corners":[0,0,0,40,20,0],"size":[10,10],"depth":10}
! [invalid_argument] se_primitive {"shape":"box","corners":[0,0,0,40,0,0,80,0,0],"depth":10}
! [invalid_argument] se_primitive {"shape":"box","corners":[0,0,5,40,20,5],"depth":10}
! [invalid_argument] se_primitive {"shape":"cylinder","corners":[0,0,0,40,20,0],"radius":5,"depth":10}
se_documents {"action":"close","document":"{{k.handle}}","saveChanges":false}
