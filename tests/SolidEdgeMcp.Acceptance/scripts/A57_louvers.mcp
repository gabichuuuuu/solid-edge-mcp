# A57: sheet metal louvers (se_sheetmetal louver, Louvers.AddSync in synchronous modeling). A 100 x 60 tab, thickness 1 (top face z = 1).
# A lanced louver at (50, 30) along +x, 40 long, 5 wide, 3 high: centred on the point along x (30..70), opening to the left of
# +x seen from the face normal (+z), so y 30..35, rising to z = 1 + 3 = 4; a lanced end removes a little volume.
@d = se_documents {"action":"new","kind":"sheet_metal"}
@k = se_sketch {"action":"create","plane":"1"}
se_sketch {"action":"rectangle","sketch":"{{k.sketch}}","points":[0,0,100,60]}
se_sketch {"action":"close","sketch":"{{k.sketch}}"}
@t = se_sheetmetal {"action":"tab","sketch":"{{k.sketch}}"}
?= t.volume 6000
@top = se_geometry {"action":"faces","direction":[0,0,1]}
@l1 = se_sheetmetal {"action":"louver","faces":["{{top.items[0].handle}}"],"point":[50,30,1],"along":[1,0,0],"length":40,"width":5,"height":3}
?= l1.boundingBox.min[0] 30 0.001
?= l1.boundingBox.max[0] 70 0.001
?= l1.boundingBox.min[1] 30 0.001
?= l1.boundingBox.max[1] 35 0.001
?= l1.boundingBox.max[2] 4 0.001
?= l1.volumeChange -1.667 0.001
?= l1.modelingMode ordered
# Formed, rounded ends (die radius 0.5) along +y at x = 85: it opens towards -x (x 80..85).
@top2 = se_geometry {"action":"faces","direction":[0,0,1]}
@l2 = se_sheetmetal {"action":"louver","faces":["{{top2.items[0].handle}}"],"point":[85,30,1],"along":[0,1,0],"length":30,"width":5,"height":3,"louverEnd":"formed","radius":0.5}
?= l2.boundingBox.max[0] 85 0.001
?= l2.boundingBox.max[2] 4 0.001
?= l2.boundingBox.min[1] 14.708 0.001
?= l2.volumeChange 33.826 0.001
# A point off the face plane is refused; a louver past the edge of the face is rejected by Solid Edge and undone.
@top3 = se_geometry {"action":"faces","direction":[0,0,1]}
! [invalid_argument] se_sheetmetal {"action":"louver","faces":["{{top3.items[0].handle}}"],"point":[50,30,5],"along":[1,0,0],"length":40,"width":5,"height":3}
! [feature_failed] se_sheetmetal {"action":"louver","faces":["{{top3.items[0].handle}}"],"point":[98,5,1],"along":[1,0,0],"length":20,"width":5,"height":3}
@g = se_geometry {"action":"summary"}
?= g.volume {{l2.volume}} 0.001
@f = se_sheetmetal {"action":"flatten"}
se_documents {"action":"close","saveChanges":false}
