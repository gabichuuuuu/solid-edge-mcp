# A66: 3D section views by a plane (se_section_view add with plane): a rectangle around the whole model is drawn on the plane
# and its outside is kept within the extent, so the extent side is cut away. Block 40 x 20 x 10 at x 10..50 seen from the top
# on a white background: the image centre is the model point (30, 0) (as in A28). The plane 5 mm from the front plane lies at
# y = -5 with the frame normal -y: back (towards +y) cuts the centre away, front keeps it, a 6 mm slab around it (y -8..-2)
# keeps it and a 12 mm one (y -11..1) cuts it. In an assembly, plane 2 (x = 0) with the block on its +x side: the side along
# the reported frontNormal x = +1 holds the whole block.
@p = se_documents {"action":"new","kind":"part"}
se_view {"action":"background","kind":"solid","colors":["#FFFFFF"]}
@k = se_sketch {"action":"create","plane":"1"}
se_sketch {"action":"rectangle","sketch":"{{k.sketch}}","points":[10,-10,50,10]}
se_sketch {"action":"close","sketch":"{{k.sketch}}"}
se_extrude {"sketch":"{{k.sketch}}","distance":10}
se_view {"action":"orient","orientation":"top"}
@c0 = se_view {"action":"capture","width":400,"height":300,"samples":true}
@pl = se_ref_plane {"action":"offset","plane":"3","distance":5}
! [invalid_argument] se_section_view {"action":"add","plane":"{{pl.handle}}"}
! [invalid_argument] se_section_view {"action":"add","plane":"{{pl.handle}}","sketch":"{{k.sketch}}","direction":"back"}
@s1 = se_section_view {"action":"add","plane":"{{pl.handle}}","direction":"back","caption":"Back"}
?= s1.frontNormal[1] -1
?= s1.section.caption Back
@c1 = se_view {"action":"capture","width":400,"height":300,"fit":false,"samples":true}
?# c1.samples.center #FFFFFF
@d1 = se_section_view {"action":"delete","section":"{{s1.section.handle}}"}
?= d1.count 0
@s2 = se_section_view {"action":"add","plane":"{{pl.handle}}","direction":"front"}
@c2 = se_view {"action":"capture","width":400,"height":300,"fit":false,"samples":true}
?# c2.samples.center {{c0.samples.center}}
se_section_view {"action":"delete","section":"{{s2.section.handle}}"}
@s3 = se_section_view {"action":"add","plane":"{{pl.handle}}","depth":6}
@c3 = se_view {"action":"capture","width":400,"height":300,"fit":false,"samples":true}
?# c3.samples.center {{c0.samples.center}}
se_section_view {"action":"delete","section":"{{s3.section.handle}}"}
@s4 = se_section_view {"action":"add","plane":"{{pl.handle}}","depth":12}
@c4 = se_view {"action":"capture","width":400,"height":300,"fit":false,"samples":true}
?# c4.samples.center #FFFFFF
se_section_view {"action":"delete","section":"{{s4.section.handle}}"}
@l = se_section_view {"action":"list"}
?= l.count 0
se_documents {"action":"save_as","path":"{{work}}\\a66_block.par","overwrite":true}
se_documents {"action":"close","document":"{{p.handle}}","saveChanges":false}
@as = se_documents {"action":"new","kind":"assembly"}
se_view {"action":"background","kind":"solid","colors":["#FFFFFF"]}
se_assembly {"action":"insert","path":"{{work}}\\a66_block.par"}
se_view {"action":"orient","orientation":"top"}
@a0 = se_view {"action":"capture","width":400,"height":300,"samples":true}
@sa = se_section_view {"action":"add","plane":"2","direction":"front"}
?= sa.frontNormal[0] 1
@a1 = se_view {"action":"capture","width":400,"height":300,"fit":false,"samples":true}
?# a1.samples.center #FFFFFF
se_section_view {"action":"delete","section":"{{sa.section.handle}}"}
@sb = se_section_view {"action":"add","plane":"2","direction":"back"}
@a2 = se_view {"action":"capture","width":400,"height":300,"fit":false,"samples":true}
?# a2.samples.center {{a0.samples.center}}
se_section_view {"action":"delete","section":"{{sb.section.handle}}"}
se_documents {"action":"close","document":"{{as.handle}}","saveChanges":false}
