# A89: solid sweep (se_loft_sweep solid): a closed tool body moved along a path sketch, cut from or added to the part. A box
#   100 x 60 x 20 (x 0..100, y -60..0; 120000). Tool: a cylinder of radius 5, z 15..30, its axis at x 0, y -30 (a rectangle
#   revolved with endCaps on a plane at y -30). Path: the line x 0..100 at y -30. The cut is a slot 100 x 10 x 5 (z 15..20;
#   the half disks at the ends fall outside the box): -5000, its floor at z 15 is 100 x 10. Added along the same path, the
#   whole swept volume, a stadium (100 x 10 + pi 5^2) x 15 = 16178.097, fills the slot and stands up to z 30, from x -5 to 105.
@p = se_documents {"action":"new","kind":"part"}
@k = se_sketch {"action":"create","plane":"1"}
se_sketch {"action":"rectangle","sketch":"{{k.sketch}}","points":[0,-60,100,0]}
se_sketch {"action":"close","sketch":"{{k.sketch}}"}
se_extrude {"sketch":"{{k.sketch}}","distance":20}
@pl = se_ref_plane {"action":"offset","plane":"3","distance":30}
@kt = se_sketch {"action":"create","plane":"{{pl.handle}}"}
@ax = se_sketch {"action":"line","sketch":"{{kt.sketch}}","points":[0,10,0,40]}
@x = se_sketch {"action":"axis","sketch":"{{kt.sketch}}","element":"{{ax.element}}"}
se_sketch {"action":"rectangle","sketch":"{{kt.sketch}}","points":[0,15,5,30]}
se_sketch {"action":"close","sketch":"{{kt.sketch}}"}
@tool = se_surface {"action":"revolve","sketch":"{{kt.sketch}}","axis":"{{x.axis}}","angle":360,"endCaps":true}
@kp = se_sketch {"action":"create","plane":"1"}
se_sketch {"action":"line","sketch":"{{kp.sketch}}","points":[0,-30,100,-30]}
se_sketch {"action":"close","sketch":"{{kp.sketch}}","open":true}
@c = se_loft_sweep {"action":"solid","operation":"cut","tool":"{{tool.surface.handle}}","path":"{{kp.sketch}}"}
?= c.volumeChange -5000 0.01
?= c.volume 115000 0.01
@up = se_geometry {"action":"faces","direction":[0,0,1]}
?= up.items[?area=1000].boundingBox.min[2] 15 0.001
?= up.items[?area=1000].boundingBox.min[1] -35 0.001
?= up.items[?area=1000].boundingBox.max[0] 100 0.001
# added along the same path
@a = se_loft_sweep {"action":"solid","tool":"{{tool.surface.handle}}","path":"{{kp.sketch}}"}
?= a.volumeChange 16178.097 0.01
@g = se_geometry {"action":"summary"}
?= g.boundingBox.max[2] 30 0.001
?= g.boundingBox.min[0] -5 0.001
?= g.boundingBox.max[0] 105 0.001
# refusals: no tool, no path, an open surface as the tool, a surface as the path, a face of the part as the tool
@kt2 = se_sketch {"action":"create","plane":"{{pl.handle}}"}
@ax2 = se_sketch {"action":"line","sketch":"{{kt2.sketch}}","points":[50,10,50,40]}
@x2 = se_sketch {"action":"axis","sketch":"{{kt2.sketch}}","element":"{{ax2.element}}"}
se_sketch {"action":"rectangle","sketch":"{{kt2.sketch}}","points":[50,35,55,40]}
se_sketch {"action":"close","sketch":"{{kt2.sketch}}"}
@open = se_surface {"action":"revolve","sketch":"{{kt2.sketch}}","axis":"{{x2.axis}}","angle":180}
! [invalid_argument] se_loft_sweep {"action":"solid","path":"{{kp.sketch}}"}
! [invalid_argument] se_loft_sweep {"action":"solid","tool":"{{tool.surface.handle}}"}
! [invalid_argument] se_loft_sweep {"action":"solid","tool":"{{open.surface.handle}}","path":"{{kp.sketch}}"}
! [handle_wrong_type] se_loft_sweep {"action":"solid","tool":"{{tool.surface.handle}}","path":"{{tool.surface.handle}}"}
@f = se_geometry {"action":"faces","direction":[0,-1,0]}
! [invalid_argument] se_loft_sweep {"action":"solid","tool":"{{f.items[0].handle}}","path":"{{kp.sketch}}"}
@ph = se_physical {}
?= ph.volume 131178.097 0.01
se_documents {"action":"close","document":"{{p.handle}}","saveChanges":false}
